---
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer-top"><a class="footer-logo" href="/" aria-label="3dev, inicio">3<span>/</span>dev</a><p>Un estudio de diseño y tecnología.<br />Puebla, México. Trabajando sin fronteras.</p><a class="footer-email" href="mailto:contacto@3dev.mx">contacto@3dev.mx <span aria-hidden="true">↗</span></a></div>
    <div class="footer-bottom"><span>© {year} 3dev · brand · product · ai</span><nav aria-label="Pie de página"><a href="/casos">Proyectos</a><a href="/capacidades">Capacidades</a><a href="/#por-que">Estudio</a><a href="/contacto">Contacto</a></nav><span class="status"><i aria-hidden="true"></i> currently building</span><span>puebla / <time id="puebla-time">UTC−6</time></span></div>
  </div>
</footer>
<script>
  const clock = document.getElementById('puebla-time');
  if (clock) {
    const format = new Intl.DateTimeFormat('es-MX', {timeZone:'America/Mexico_City', hour:'2-digit', minute:'2-digit', hourCycle:'h23'});
    const update = () => { clock.textContent = format.format(new Date()); };
    update();
    window.setInterval(update, 60000);
  }
</script>
<style>
  .footer { background: var(--surface-bg); color: var(--text-primary); padding-block: var(--s-16) var(--s-6); }
  .footer-top { display: flex; align-items: center; justify-content: space-between; gap: var(--s-8); padding-bottom: var(--s-12); }
  .footer-logo { font: 500 clamp(36px,5vw,64px)/1 var(--font-mono); letter-spacing: -0.09em; }
  .footer-logo span { color: var(--accent-default); }
  .footer-top p { font-size: 13px; line-height: 1.7; color: var(--text-secondary); }
  .footer-email { min-height: 44px; display: flex; align-items: center; gap: var(--s-6); font: 12px/1.5 var(--font-mono); }
  .footer-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--s-6); border-top: 1px solid var(--border-default); padding-top: var(--s-5); font: 10px/1.6 var(--font-mono); color: var(--text-secondary); }
  nav { display: flex; flex-wrap: wrap; gap: var(--s-5); }
  nav a { display: flex; align-items: center; min-height: 44px; transition: color var(--m-fast) var(--ease-out); }
  a:hover { color: var(--accent-default); }
  .status { display: flex; align-items: center; gap: var(--s-2); }
  .status i { background: var(--accent-default); width: 5px; height: 5px; border-radius: var(--r-full); }
  @media (max-width: 63.99rem) { .footer-bottom { flex-wrap: wrap; } }
  @media (max-width: 47.99rem) { .footer-top,.footer-bottom { flex-direction: column; align-items: start; } .footer-top { gap: var(--s-6); padding-bottom: var(--s-8); } .footer-bottom { gap: var(--s-3); } .footer { padding-top: var(--s-12); } }
</style>
