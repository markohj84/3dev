---
// src/components/Footer.astro — grid 4 cols, status dot pulsante
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand col -->
      <div>
        <a href="/" class="footer-logo">3<span class="slash">/</span>dev</a>
        <div class="footer-brand-tag">brand · product · ai</div>
        <p class="footer-brand-copy">
          Estudio mexicano de producto digital con IA integrada.
          Construimos para empresas que ya decidieron no esperar el futuro.
        </p>
      </div>

      <!-- Sitio -->
      <div class="footer-col">
        <div class="footer-col-label">Sitio</div>
        <ul>
          <li><a href="/capacidades">Capacidades</a></li>
          <li><a href="/casos">Proyectos</a></li>
          <li><a href="/#proceso">Proceso</a></li>
        </ul>
      </div>

      <!-- Estudio -->
      <div class="footer-col">
        <div class="footer-col-label">Estudio</div>
        <ul>
          <li><a href="#">Manifiesto</a></li>
          <li><a href="#">Sobre nosotros</a></li>
          <li><a href="#">Privacidad</a></li>
        </ul>
      </div>

      <!-- Contacto -->
      <div class="footer-col">
        <div class="footer-col-label">Contacto</div>
        <ul>
          <li><a href="https://linkedin.com/company/3dev-studio" target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a href="https://x.com/3devstudio" target="_blank" rel="noopener">X / Twitter</a></li>
          <li><a href="mailto:contacto@3dev.mx">contacto@3dev.mx</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} · 3dev studio · made in Puebla, México</span>
      <span class="footer-status">
        <span class="status-dot"></span>
        v2.0 · status: building
      </span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 80px 0 32px;
    border-top: 1px solid var(--border-sub);
    background: var(--surface-sunken);
    position: relative;
    z-index: 2;
  }

  .footer-logo {
    font-family: var(--font-mono);
    font-size: 24px;
    font-weight: 500;
    color: var(--text-primary);
    letter-spacing: -0.3px;
  }
  .footer-logo .slash { color: var(--accent-default); font-weight: 400; }

  .footer-brand-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-tertiary);
    margin-top: 12px;
    letter-spacing: 0.4px;
  }

  .footer-brand-copy {
    margin-top: 24px;
    font-size: 13px;
    color: var(--text-secondary);
    max-width: 320px;
    line-height: 1.55;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
    padding-bottom: 56px;
    border-bottom: 1px solid var(--border-sub);
    margin-bottom: 32px;
  }

  .footer-col-label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-tertiary);
    letter-spacing: 1.2px;
    margin-bottom: 18px;
    text-transform: uppercase;
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-col li a {
    font-size: 13px;
    color: var(--text-secondary);
    transition: color var(--m-fast);
  }
  .footer-col li a:hover { color: var(--text-primary); }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-tertiary);
    letter-spacing: 0.3px;
  }

  .footer-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background: var(--accent-default);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
    box-shadow: 0 0 8px var(--accent-default);
  }

  @media (max-width: 1024px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 40px; }
  }
  @media (max-width: 720px) {
    .footer-grid { grid-template-columns: 1fr; }
    .footer-bottom { flex-direction: column; gap: 12px; text-align: center; }
  }
</style>
