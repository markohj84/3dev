---
interface Props { editorial?: boolean; }
const { editorial = false } = Astro.props;
const links = [
  { href: '/casos', label: 'Proyectos' },
  { href: '/capacidades', label: 'Capacidades' },
  { href: '/#proceso', label: 'Proceso' },
  { href: '/#por-que', label: 'Estudio' },
];
---
<header class="site-header" data-surface={editorial ? 'paper' : 'ink'}>
  <nav class="navigation container" aria-label="Principal">
    <a href="/" class="logo" aria-label="3dev, inicio">3<span>/</span>dev</a>
    <div class="desktop-links">
      {links.map(link => <a href={link.href} aria-current={Astro.url.pathname === link.href ? 'page' : undefined}>{link.label}</a>)}
    </div>
    <a href="/contacto" class="contact-link">Hablemos <span aria-hidden="true">↗</span></a>
    <button class="menu-trigger" type="button" aria-haspopup="dialog" aria-controls="mobile-menu" aria-expanded="false" hidden>Menú <span aria-hidden="true">＋</span></button>
  </nav>
  <dialog id="mobile-menu" class="mobile-menu" aria-labelledby="menu-title">
    <div class="menu-top"><span id="menu-title">3/dev · navegación</span><form method="dialog"><button class="menu-close" aria-label="Cerrar menú" autofocus>Cerrar <span aria-hidden="true">×</span></button></form></div>
    <nav aria-label="Navegación móvil" class="mobile-links">
      {links.map((link, index) => <a href={link.href}><span class="index" aria-hidden="true">0{index + 1}</span>{link.label}<span class="menu-arrow" aria-hidden="true">↗</span></a>)}
      <a href="/contacto"><span class="index" aria-hidden="true">05</span>Hablemos<span class="menu-arrow" aria-hidden="true">↗</span></a>
    </nav>
    <div class="menu-bottom"><span>Puebla, México</span><span>brand · product · ai</span></div>
  </dialog>
</header>
<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const trigger = header?.querySelector<HTMLButtonElement>('.menu-trigger');
  const menu = header?.querySelector<HTMLDialogElement>('#mobile-menu');
  if (header && trigger && menu && typeof menu.showModal === 'function') {
    header.dataset.enhanced = 'true';
    let compact = false;
    const updateDensity = () => {
      const next = window.scrollY > 64;
      if (next !== compact) { compact = next; header.dataset.compact = String(next); }
    };
    window.addEventListener('scroll', updateDensity, { passive: true });
    updateDensity();
    trigger.hidden = false;
    trigger.addEventListener('click', () => { menu.showModal(); trigger.setAttribute('aria-expanded', 'true'); });
    menu.addEventListener('close', () => { trigger.setAttribute('aria-expanded', 'false'); });
    menu.querySelectorAll<HTMLAnchorElement>('a').forEach(link => link.addEventListener('click', () => menu.close()));
    window.matchMedia('(min-width: 48rem)').addEventListener('change', event => { if (event.matches && menu.open) menu.close(); });
  }
</script>
<style>
  .site-header { position: sticky; top: 0; z-index: 100; background: var(--surface-bg); color: var(--text-primary); border-bottom: 1px solid var(--border-sub); }
  .navigation { display: flex; align-items: center; justify-content: space-between; gap: var(--s-6); min-height: var(--nav-height); }
  .site-header[data-compact="true"] .navigation { min-height: 72px; }
  .logo { font: 600 30px/1 var(--font-mono); letter-spacing: -0.08em; white-space: nowrap; }
  .logo span { color: var(--accent-default); }
  .desktop-links { display: flex; align-items: center; gap: clamp(20px, 3vw, 40px); }
  .desktop-links a { display: grid; place-items: center; position: relative; min-height: 44px; font-size: 13px; transition: color var(--m-fast) var(--ease-out); }
  .desktop-links a::after { content: ''; position: absolute; bottom: 8px; left: 0; right: 0; height: 1px; background: var(--accent-default); transform: scaleX(0); transform-origin: left; transition: transform var(--m-fast) var(--ease-out); }
  .desktop-links a:hover::after, .desktop-links a[aria-current]::after { transform: scaleX(1); }
  .desktop-links a:hover,.contact-link:hover,.menu-trigger:hover,.menu-close:hover,.mobile-links a:hover { color: var(--accent-default); }
  .contact-link { display: inline-flex; align-items: center; gap: var(--s-6); min-height: 44px; font: 500 12px var(--font-mono); transition: color var(--m-fast) var(--ease-out); }
  .contact-link span { font-size: 20px; }
  .menu-trigger, .menu-close { min-height: 44px; padding: var(--s-2); align-items: center; gap: var(--s-3); font: 500 12px var(--font-mono); transition: color var(--m-fast) var(--ease-out); }
  .menu-trigger { display: none; }
  .menu-trigger span, .menu-close span { font-size: 24px; }
  .mobile-menu { position: fixed; inset: 0; width: 100%; height: 100%; height: 100dvh; max-width: none; max-height: none; border: 0; padding: var(--s-6); background: var(--surface-bg); color: var(--text-primary); }
  .mobile-menu[open] { display: flex; flex-direction: column; }
  .mobile-menu::backdrop { background: var(--surface-bg); }
  .menu-top, .menu-bottom { display: flex; justify-content: space-between; align-items: center; gap: var(--s-4); font: 11px/1.5 var(--font-mono); }
  .menu-top { border-bottom: 1px solid var(--border-default); padding-bottom: var(--s-4); }
  .menu-close { display: inline-flex; }
  .mobile-links { margin-block: auto; padding-block: var(--s-8); }
  .mobile-links a { display: flex; align-items: center; gap: var(--s-4); padding-block: var(--s-4); font-size: clamp(24px, 7vw, 44px); letter-spacing: -0.04em; transition: color var(--m-fast) var(--ease-out); }
  .index { font: 11px var(--font-mono); color: var(--text-secondary); letter-spacing: 0; }
  .menu-arrow { margin-left: auto; color: var(--accent-default); }
  .menu-bottom { padding-top: var(--s-4); border-top: 1px solid var(--border-default); flex-wrap: wrap; }
  @media (max-width: 47.99rem) {
    .navigation { min-height: 72px; gap: var(--s-4); flex-wrap: wrap; padding-block: var(--s-3); }
    .logo { font-size: 26px; }
    .contact-link { margin-left: auto; }
    .desktop-links { order: 4; width: 100%; flex-wrap: wrap; gap: var(--s-2) var(--s-5); }
    [data-enhanced] .desktop-links { display: none; }
    [data-enhanced] .menu-trigger:not([hidden]) { display: inline-flex; }
  }
</style>
