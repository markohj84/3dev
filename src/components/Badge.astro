---
interface Props { left?: string; right?: string; class?: string; }
const { left, right, class: className = '' } = Astro.props;
---
<div class:list={['status', className]}>
  {left && <span>{left}</span>}
  {right && <span class="status-detail"><span class="dot" aria-hidden="true"></span>{right}</span>}
</div>
<style>
  .status { display: flex; flex-wrap: wrap; gap: var(--s-4); font: 400 11px/1.5 var(--font-mono); color: var(--text-secondary); }
  .status-detail { display: inline-flex; align-items: center; gap: var(--s-2); }
  .dot { width: 6px; height: 6px; border-radius: var(--r-full); background: var(--accent-default); }
</style>
