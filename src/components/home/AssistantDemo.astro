<section class="assistant-demo" aria-label="Ejemplo animado de un asistente de inteligencia artificial">
  <div class="demo-top"><span><i aria-hidden="true"></i> 3dev / intelligence</span><span>demo conceptual</span></div>
  <div class="bot-scene" aria-hidden="true">
    <svg viewBox="0 0 440 240" fill="none">
      <ellipse class="orbit orbit-back" cx="220" cy="126" rx="184" ry="67" />
      <ellipse class="orbit" cx="220" cy="126" rx="137" ry="96" />
      <path class="connector" d="M36 126H150M290 126H404M220 30V60M220 185V222" />
      <circle class="node" cx="36" cy="126" r="4"/><circle class="node" cx="404" cy="126" r="4"/>
      <circle class="node" cx="220" cy="30" r="4"/><circle class="node" cx="220" cy="222" r="4"/>
      <g class="bot">
        <path class="antenna" d="M220 80V65"/><circle class="signal" cx="220" cy="60" r="5"/>
        <rect class="bot-body" x="154" y="80" width="132" height="96" rx="8"/>
        <rect class="bot-face" x="166" y="92" width="108" height="65" rx="6"/>
        <path class="eyes" d="M190 116V129M250 116V129"/>
        <path class="smile" d="M211 140Q220 146 229 140"/>
        <path class="ears" d="M145 112V139M295 112V139"/>
        <path class="chin" d="M210 166H230"/>
      </g>
      <g class="packet"><circle cx="87" cy="126" r="4"/></g>
    </svg>
    <span class="scene-label">Diseñado para entender.<br />Conectado para resolver.</span>
  </div>
  <div class="conversation">
    <div class="request step"><span class="speaker">Tú</span><p>Quiero un bot que atienda a mis clientes y organice mis citas.</p><span class="request-arrow" aria-hidden="true">↗</span></div>
    <div class="workflow step"><span class="workflow-label">Una intención. Un flujo conectado.</span><div class="workflow-nodes"><span>Entender</span><i aria-hidden="true">→</i><span>Conectar</span><i aria-hidden="true">→</i><span>Resolver</span></div></div>
    <div class="answer step"><span class="speaker">3dev AI <span aria-hidden="true">↳</span></span><p>Un asistente que responde, consulta disponibilidad y te ayuda a coordinar cada cita.</p></div>
  </div>
  <div class="demo-footer"><span>Tu negocio, con nuevas posibilidades.</span><button type="button" class="replay" hidden aria-label="Repetir la animación del asistente">Repetir <span aria-hidden="true">↻</span></button></div>
</section>
<style>
  .assistant-demo { min-width: 0; border: 1px solid var(--border-sub); border-radius: var(--r-lg); background: var(--surface-elev); padding: var(--s-5); }
  .demo-top,.demo-footer { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); font: 9px/1.5 var(--font-mono); color: var(--text-secondary); }
  .demo-top > span:first-child { display: flex; align-items: center; gap: var(--s-2); color: var(--text-primary); }
  .demo-top i { width: 5px; height: 5px; border-radius: var(--r-full); background: var(--accent-default); }
  .bot-scene { position: relative; padding-block: var(--s-3) var(--s-6); }
  svg { display: block; width: 100%; overflow: visible; }
  .orbit { stroke: var(--border-sub); } .orbit-back { stroke-dasharray: 3 7; }
  .connector { stroke: var(--border-default); stroke-dasharray: 2 5; }
  .node { fill: var(--surface-elev); stroke: var(--accent-default); }
  .bot-body { fill: var(--surface-sunken); stroke: var(--accent-default); }
  .bot-face { fill: var(--surface-bg); stroke: var(--border-sub); }
  .antenna,.ears,.chin { stroke: var(--accent-default); stroke-width: 2; stroke-linecap: round; }
  .signal,.packet { fill: var(--accent-default); }
  .eyes { stroke: var(--accent-default); stroke-width: 7; stroke-linecap: round; }
  .smile { stroke: var(--accent-default); stroke-width: 2; stroke-linecap: round; }
  .scene-label { display: block; text-align: center; font: 10px/1.6 var(--font-mono); color: var(--text-secondary); margin-top: -8px; }
  .conversation { display: grid; gap: var(--s-5); }
  .request { display: grid; grid-template-columns: 1fr auto; gap: var(--s-2) var(--s-4); padding: var(--s-4); background: var(--surface-paper); color: var(--text-on-paper); border-radius: var(--r-sm); }
  .speaker { font: 10px/1.5 var(--font-mono); }
  .request p { grid-column: 1; } .request-arrow { grid-column: 2; grid-row: 1 / 3; align-self: center; font-size: 22px; }
  .conversation p { font-size: 14px; line-height: 1.55; }
  .workflow-label { font: 9px/1.5 var(--font-mono); color: var(--text-secondary); }
  .workflow-nodes { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); margin-top: var(--s-2); font: 10px/1.5 var(--font-mono); }
  .workflow-nodes span { border: 1px solid var(--border-default); border-radius: var(--r-xs); padding: var(--s-2) var(--s-3); }
  .workflow-nodes i { font-style: normal; color: var(--accent-default); }
  .answer .speaker { display: flex; justify-content: space-between; color: var(--accent-default); margin-bottom: var(--s-2); }
  .answer p { color: var(--text-secondary); }
  .demo-footer { border-top: 1px solid var(--border-sub); margin-top: var(--s-5); padding-top: var(--s-2); min-height: 52px; }
  .replay { min-height: 44px; padding-inline: var(--s-2); white-space: nowrap; color: var(--text-primary); }
  .replay:hover { color: var(--accent-default); } .replay[hidden] { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    .bot { animation: greet 4.4s var(--ease-out) both; transform-origin: 220px 128px; }
    .packet { animation: connect 2s var(--ease-out) .5s both; }
    .step { animation: arrive .7s var(--ease-out) both; }
    .request { animation-delay: .3s; } .workflow { animation-delay: 1.3s; } .answer { animation-delay: 2.5s; }
  }
  @keyframes greet { 0% { transform: translateY(8px); } 35% { transform: translateY(-5px) rotate(-3deg); } 70% { transform: translateY(-3px) rotate(2deg); } 100% { transform: none; } }
  @keyframes connect { 0% { opacity: 0; transform: translateX(-40px); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateX(240px); } }
  @keyframes arrive { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .packet,.replay { display: none; } }
  @media (max-width: 30rem) { .assistant-demo { padding: var(--s-4); } .workflow-nodes span { padding: var(--s-2); } .demo-footer { font-size: 8px; } }
</style>
<script>
  document.querySelectorAll<HTMLElement>('.assistant-demo').forEach((demo) => {
    const replay = demo.querySelector<HTMLButtonElement>('.replay');
    if (!replay) return;
    replay.hidden = false;
    replay.addEventListener('click', () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      demo.getAnimations({ subtree: true }).forEach((animation) => {
        animation.currentTime = 0;
        animation.play();
      });
    });
  });
</script>
