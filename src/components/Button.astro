---
// src/components/Button.astro
// Variantes: primary | secondary | ghost
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  target?: string;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  class: className = '',
  target,
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['btn', `btn-${variant}`, className]}
  href={href}
  type={!href ? type : undefined}
  target={target}
>
  <slot />
</Tag>

<style>
  .btn {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 26px;
    border-radius: var(--r-md);
    position: relative;
    overflow: hidden;
    cursor: pointer;
    border: none;
    transition:
      transform var(--m-fast) var(--ease-out),
      box-shadow var(--m-base) var(--ease-out),
      border-color var(--m-base) var(--ease-out),
      background var(--m-base) var(--ease-out);
  }

  /* PRIMARY */
  .btn-primary {
    background: var(--grad-accent);
    color: var(--text-on-accent);
    box-shadow: 0 4px 20px rgba(93, 196, 164, 0.25), inset 0 1px 0 rgba(255,255,255,0.15);
  }
  .btn-primary::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.28), transparent);
    transition: left 700ms var(--ease-out);
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(93, 196, 164, 0.45), inset 0 1px 0 rgba(255,255,255,0.2);
  }
  .btn-primary:hover::before { left: 100%; }
  .btn-primary:active { transform: translateY(0); }

  /* SECONDARY (glass) */
  .btn-secondary {
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
    color: var(--text-primary);
  }
  .btn-secondary:hover {
    border-color: var(--glass-border-accent);
    background: var(--glass-bg-strong);
    transform: translateY(-2px);
  }

  /* GHOST */
  .btn-ghost {
    background: transparent;
    border: 1px solid var(--border-default);
    color: var(--text-secondary);
    padding: 12px 20px;
    font-size: 13px;
  }
  .btn-ghost:hover {
    border-color: var(--accent-default);
    color: var(--text-primary);
  }
</style>
