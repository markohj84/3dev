---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  target?: string;
}
const { variant = 'primary', href, type = 'button', class: className = '', target } = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag class:list={['button', `button-${variant}`, className]} href={href} type={!href ? type : undefined} target={target} rel={target === '_blank' ? 'noopener noreferrer' : undefined}>
  <slot />
</Tag>
<style>
  .button { display: inline-flex; align-items: center; justify-content: space-between; gap: var(--s-8); min-height: 48px; padding: var(--s-4) var(--s-5); border: 1px solid transparent; border-radius: var(--r-sm); font: 500 12px/1.3 var(--font-mono); transition: background var(--m-fast), border-color var(--m-fast), color var(--m-fast); }
  .button-primary { background: var(--surface-brand); color: var(--text-on-brand); }
  .button-primary:hover { border-color: currentColor; }
  .button-secondary, .button-ghost { color: var(--text-primary); border-color: var(--border-default); }
  .button-secondary:hover, .button-ghost:hover { background: var(--surface-elev); border-color: var(--accent-default); color: var(--accent-default); }
  .button :global(.arrow) { transition: transform var(--m-fast) var(--ease-out); }
  .button:hover :global(.arrow) { transform: translate(3px, -3px); }
</style>
