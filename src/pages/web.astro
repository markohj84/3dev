---
import BaseLayout from '../layouts/BaseLayout.astro';
import offer from '../../docs/strategy/oferta.json';

const plans = offer.lines.find(line => line.id === 'web')!.items;
const formatPrice = (amount: number) => amount.toLocaleString('es-MX');
const whatsappUrl = (plan: (typeof plans)[number]) =>
  `https://wa.me/522223576770?text=${encodeURIComponent(`Hola, 3dev. Me interesa ${plan.name} ($${formatPrice(plan.setup)} MXN). Quiero dar el siguiente paso con mi sitio web.`)}`;
---
<BaseLayout title="Planes de desarrollo web — 3dev" description="Explora Web Esencial, Web Completa y Tienda en línea. Compara alcances, precios y una muestra real del trabajo de 3dev." ogImage="/images/web/nogal-desktop.jpg" assistant={false}>
<div id="web-page" class="web-page no-js">
<section id="inicio" class="hero is-transformed" aria-labelledby="hero-title" data-scene="La transformación"><div class="wrap">
<div class="hero-layout"><div class="hero-copy"><p class="eyebrow section-number">DISEÑO QUE SE VE. DIFERENCIA QUE SE SIENTE.</p><h1 id="hero-title">Tu negocio.<br>Una web<br><span class="accent">a otro nivel.</span></h1><p class="hero-desc">Tu negocio, con una presencia clara y profesional. Explora nuestro demo de Clínica Dental Nogal y descubre Web Esencial.</p><div class="hero-actions"><a class="button primary" href="https://demo.3dev.mx/" target="_blank" rel="noopener noreferrer">Explorar demo real <span aria-hidden="true">↗</span></a><button class="quiet-button enhancement" id="transform" aria-pressed="true" aria-controls="comparison">Comparar diseño <span aria-hidden="true">↔</span></button><button class="quiet-button enhancement" id="presentation" aria-pressed="false" aria-controls="deck">Presentar ↗</button></div><p class="hero-small">Web Esencial · ${formatPrice(plans[0].setup)} MXN · 5 días hábiles<br>Diseño, dominio y hospedaje el primer año.</p></div>
<figure class="showcase"><div class="orbit" aria-hidden="true"></div><div class="scene-top"><span class="live-dot">DEMO DE 3DEV · WEB ESENCIAL</span><span>01 / EXPLORA</span></div><div class="transform-stage"><div class="browser-bar" aria-hidden="true"><i></i><i></i><i></i><span>demo.3dev.mx / Clínica Dental Nogal</span></div><div class="comparison" id="comparison">
<div class="mock mock-before" aria-hidden="true"><div class="old-header">CLÍNICA DENTAL NOGAL</div><div class="old-links">INICIO SERVICIOS CONTACTO</div><div class="old-layout"><div><h3>Bienvenidos a nuestra página web</h3><p>Atención dental para toda la familia en Puebla. Conoce nuestros servicios y contáctanos para tu próxima consulta.</p></div><img src="/images/web/nogal-dental.jpg" alt="" width="640" height="480"></div><p class="old-footer">Sitio básico ilustrativo · No es una versión anterior del demo</p></div>
<div class="mock mock-after" aria-hidden="true"><img class="nogal-hero-capture" src="/images/web/nogal-desktop.jpg" alt="" width="1280" height="920" fetchpriority="high"></div><div class="split-line enhancement" aria-hidden="true"></div><input class="comparison-range enhancement" type="range" id="reveal" min="0" max="100" value="0" aria-label="Comparar diseño: 0 muestra el demo de Clínica Dental Nogal, 100 muestra un sitio básico ilustrativo"></div></div><figcaption class="stage-bottom"><span id="transform-caption" aria-live="polite">Clínica Dental Nogal · Demo de 3dev</span><a class="demo-open" href="https://demo.3dev.mx/" target="_blank" rel="noopener noreferrer">Abrir demo <span aria-hidden="true">↗</span></a></figcaption><p class="demo-scope">Referencia visual. Web Esencial incluye una sección; el demo muestra secciones extra y a Lía, que se cotizan por separado.</p><div class="result-tags" aria-hidden="true"><span>↗ Identidad propia</span><span>↗ Recorrido claro</span><span>↗ Contacto a mano</span></div></figure></div>
<div class="hero-base"><span>Brand · Product · AI &nbsp; / &nbsp; Hecho en México</span><a href="#explora">Tres formas de dar el siguiente paso <span aria-hidden="true">↘</span></a></div></div></section>
<section class="section paper" data-surface="paper" id="explora" aria-labelledby="explore-title" data-scene="Explora tu plan"><div class="wrap"><p class="eyebrow section-number">02 / TU NEGOCIO MARCA EL PUNTO DE PARTIDA</p><div class="section-head"><h2 id="explore-title">No solo lo imagines.<br><span class="accent">Explóralo.</span></h2><p>Elige lo que necesitas. Mira cómo cambia la experiencia en una pantalla grande o en la palma de tu mano.</p></div>
<div class="plan-tabs enhancement" role="tablist" aria-label="Explorar planes web"><button class="plan-tab" id="tab-web-esencial" role="tab" aria-controls="panel-web-esencial" aria-selected="false" data-plan="web-esencial"><small>01 / PRESENCIA</small><strong>Web Esencial</strong><span class="tab-price">${formatPrice(plans[0].setup)} MXN</span><span class="tab-arrow" aria-hidden="true">↗</span></button>
<button class="plan-tab" id="tab-web-completa" role="tab" aria-controls="panel-web-completa" aria-selected="false" data-plan="web-completa"><small>02 / CONFIANZA</small><strong>Web Completa</strong><span class="tab-price">${formatPrice(plans[1].setup)} MXN</span><span class="tab-arrow" aria-hidden="true">↗</span></button>
<button class="plan-tab" id="tab-tienda-en-linea" role="tab" aria-controls="panel-tienda-en-linea" aria-selected="false" data-plan="tienda-en-linea"><small>03 / CATÁLOGO</small><strong>Tienda en línea</strong><span class="tab-price">${formatPrice(plans[2].setup)} MXN</span><span class="tab-arrow" aria-hidden="true">↗</span></button>
</div>
<article class="plan-panel" id="panel-web-esencial" role="tabpanel" aria-labelledby="tab-web-esencial" tabindex="0">
<div class="plan-info"><div class="plan-details"><p class="eyebrow">5 DÍAS HÁBILES</p><h3>Haz que te encuentren.</h3><p>Una sola sección para presentar tu negocio, mostrar lo esencial y facilitar el contacto.</p><ul><li>Una sola sección</li><li>Galería de hasta 5 fotografías</li><li>5 cuentas de correo</li></ul></div><p class="price">${formatPrice(plans[0].setup)} <small>MXN</small></p><p class="price-note">Pago único por el sitio</p><div class="plan-actions"><a class="button primary" href={whatsappUrl(plans[0])} target="_blank" rel="noopener noreferrer" data-choose="web-esencial">Lo quiero · WhatsApp <span aria-hidden="true">↗</span></a><a class="text-link" href="https://demo.3dev.mx/" target="_blank" rel="noopener">Abrir demo real ↗</a></div></div>
<div class="demo-shell"><div class="demo-tools"><span>DEMO REAL · CLÍNICA DENTAL NOGAL</span><div class="device-group enhancement" role="group" aria-label="Dispositivo para Web Esencial"><button data-device-button="desktop" aria-pressed="true">Escritorio</button><button data-device-button="mobile" aria-pressed="false">Celular</button></div></div><div class="demo-frame" data-device="desktop"><div class="browser-bar" aria-hidden="true"><i></i><i></i><i></i><span>demo.3dev.mx</span></div><div class="demo-content"><a class="nogal-preview" href="https://demo.3dev.mx/" target="_blank" rel="noopener noreferrer" aria-label="Abrir el demo de Clínica Dental Nogal en una nueva pestaña"><img class="nogal-desktop" src="/images/web/nogal-desktop.jpg" alt="Vista de escritorio del demo de Clínica Dental Nogal" width="1280" height="920" loading="lazy"><img class="nogal-mobile" src="/images/web/nogal-mobile.jpg" alt="Vista móvil del demo de Clínica Dental Nogal" width="390" height="1100" loading="lazy"></a></div></div><p class="demo-caption">Captura del demo: ábrelo para interactuar. La clínica es de ejemplo. Web Esencial incluye una sección; las secciones extra y Lía se cotizan por separado.</p></div>
</article>
<article class="plan-panel" id="panel-web-completa" role="tabpanel" aria-labelledby="tab-web-completa" tabindex="0">
<div class="plan-info"><div class="plan-details"><p class="eyebrow">10 DÍAS HÁBILES</p><h3>Cuenta todo lo que haces.</h3><p>Hasta 10 secciones o páginas para contar tu historia y explicar tus servicios con detalle.</p><ul><li>Hasta 10 secciones o páginas</li><li>Galería de hasta 10 fotografías</li><li>10 cuentas de correo</li></ul></div><p class="price">${formatPrice(plans[1].setup)} <small>MXN</small></p><p class="price-note">Pago único por el sitio</p><div class="plan-actions"><a class="button primary" href={whatsappUrl(plans[1])} target="_blank" rel="noopener noreferrer" data-choose="web-completa">Lo quiero · WhatsApp <span aria-hidden="true">↗</span></a></div></div>
<div class="demo-shell"><div class="demo-tools"><span>PRUEBA LA VISTA PREVIA</span><div class="device-group enhancement" role="group" aria-label="Dispositivo para Web Completa"><button data-device-button="desktop" aria-pressed="true">Escritorio</button><button data-device-button="mobile" aria-pressed="false">Celular</button></div></div><div class="demo-frame" data-device="desktop"><div class="browser-bar" aria-hidden="true"><i></i><i></i><i></i><span>Diseño conceptual / Casa Alba</span></div><div class="demo-content"><div class="alba-header"><span class="alba-logo">casa alba.</span><div class="mini-tabs enhancement" role="group" aria-label="Páginas de la vista previa"><button data-preview-view="home" aria-pressed="true">Inicio</button><button data-preview-view="services" aria-pressed="false">Espacios</button><button data-preview-view="contact" aria-pressed="false">Contacto</button></div></div><div data-view="home"><div class="alba-hero"><img src="/images/web/interior.jpg" alt="Interior abierto y luminoso, ejemplo visual de un estudio de interiorismo" width="1400" height="933" loading="lazy"><div class="alba-message"><small>DISEÑO PARA HABITAR</small><h3>Tu forma<br>de vivir.<br>Tu espacio.</h3><p>Diseñamos espacios con intención.</p></div></div><div class="alba-foot"><span>Interiores · Espacios · Objetos</span><span>México ↗</span></div></div><div class="alba-view" data-view="services" hidden><h4>Diseñamos<br>lo cotidiano.</h4><p class="service-word">Espacios que acompañan tu manera de vivir.</p><figure><img class="service-image" src="/images/web/interior.jpg" alt="Ejemplo de un proyecto de interiores" width="1400" height="933" loading="lazy"><figcaption class="service-word">01 / Espacios para vivir</figcaption></figure><figure><img class="service-image" src="/images/web/object.jpg" alt="Jarrones con flores y objetos decorativos" width="900" height="600" loading="lazy"><figcaption class="service-word">02 / Detalles con intención</figcaption></figure></div><div class="sample-contact" data-view="contact" hidden><div><h4>Todo empieza<br>con una idea.</h4><p>Cuéntanos cómo imaginas tu espacio.</p><p>En tu sitio: formulario, WhatsApp y ubicación.</p><small>Contenido ilustrativo.</small></div><img src="/images/web/object.jpg" alt="Detalle floral sobre una mesa de madera" width="900" height="600" loading="lazy"></div></div></div><p class="demo-caption">Prueba Inicio, Espacios y Contacto. Ejemplo conceptual; no es un proyecto de cliente.</p></div>
</article>
<article class="plan-panel" id="panel-tienda-en-linea" role="tabpanel" aria-labelledby="tab-tienda-en-linea" tabindex="0">
<div class="plan-info"><div class="plan-details"><p class="eyebrow">10 DÍAS HÁBILES</p><h3>Dale espacio a tus productos.</h3><p>Un catálogo para que tus clientes exploren lo que vendes y te contacten para pedirlo.</p><ul><li>Hasta 10 secciones y catálogo</li><li>Hospedaje especializado</li><li>Cuentas de correo ilimitadas</li></ul></div><p class="price">${formatPrice(plans[2].setup)} <small>MXN</small></p><p class="price-note">Pago único por el sitio</p><div class="plan-actions"><a class="button primary" href={whatsappUrl(plans[2])} target="_blank" rel="noopener noreferrer" data-choose="tienda-en-linea">Lo quiero · WhatsApp <span aria-hidden="true">↗</span></a></div><p class="plan-note">Incluye catálogo. La pasarela de pago se cotiza por separado.</p></div>
<div class="demo-shell"><div class="demo-tools"><span>PRUEBA LA VISTA PREVIA</span><div class="device-group enhancement" role="group" aria-label="Dispositivo para Tienda en línea"><button data-device-button="desktop" aria-pressed="true">Escritorio</button><button data-device-button="mobile" aria-pressed="false">Celular</button></div></div><div class="demo-frame" data-device="desktop"><div class="browser-bar" aria-hidden="true"><i></i><i></i><i></i><span>Diseño conceptual / Casa Alba</span></div><div class="demo-content"><div class="catalog-header"><strong>alba / objetos.</strong><span class="mono">COLECCIÓN 01</span></div><p class="catalog-title">Lo que hace tuyo un espacio.</p><div class="catalog-filter enhancement" role="group" aria-label="Categorías del catálogo de ejemplo"><button data-category-button="todos" aria-pressed="true">Todo</button><button data-category-button="objetos" aria-pressed="false">Objetos</button><button data-category-button="espacios" aria-pressed="false">Espacios</button></div><div class="products"><figure class="product" data-category="objetos"><img src="/images/web/object.jpg" alt="Jarrones blancos con flores sobre madera" width="900" height="600" loading="lazy"><figcaption>Objetos con historia<small>Ejemplo de producto</small></figcaption></figure><figure class="product" data-category="espacios"><img src="/images/web/interior.jpg" alt="Comedor de madera en un espacio contemporáneo" width="1400" height="933" loading="lazy"><figcaption>Para habitar mejor<small>Ejemplo de colección</small></figcaption></figure></div></div></div><p class="demo-caption">Filtra la colección por categoría. Ejemplo conceptual; no es un proyecto de cliente.</p></div>
</article>

<div class="common-strip"><h3>Una buena base.<br>En todos los planes.</h3><ul><li>Dominio .com o .com.mx y hospedaje, primer año</li><li>Diseño adaptable</li><li>Formulario, redes y WhatsApp</li><li>Mapa de ubicación</li></ul></div>
</div></section>
<section class="section" id="comparar" aria-labelledby="compare-title" data-scene="Compara el alcance"><div class="wrap"><div class="compare-intro"><p class="eyebrow section-number">03 / LO IMPORTANTE, A LA VISTA</p><h2 id="compare-title">Tu plan, sin vueltas.</h2></div><div class="compare-table-wrap" role="region" aria-label="Comparación de planes; desplaza horizontalmente en pantallas pequeñas" tabindex="0"><table class="compare-table"><thead><tr><th scope="col">ELIGE TU PUNTO<br>DE PARTIDA</th><th scope="col" data-plan-column="web-esencial">Web Esencial</th><th scope="col" data-plan-column="web-completa">Web Completa</th><th scope="col" data-plan-column="tienda-en-linea">Tienda en línea</th></tr></thead><tbody><tr><th scope="row">INVERSIÓN</th><td data-plan-column="web-esencial">${formatPrice(plans[0].setup)} MXN</td><td data-plan-column="web-completa">${formatPrice(plans[1].setup)} MXN</td><td data-plan-column="tienda-en-linea">${formatPrice(plans[2].setup)} MXN</td></tr><tr><th scope="row">CONTENIDO</th><td data-plan-column="web-esencial">Una sola sección</td><td data-plan-column="web-completa">Hasta 10 secciones o páginas</td><td data-plan-column="tienda-en-linea">Hasta 10 secciones + catálogo</td></tr><tr><th scope="row">IMÁGENES</th><td data-plan-column="web-esencial">Hasta 5 fotografías</td><td data-plan-column="web-completa">Hasta 10 fotografías</td><td data-plan-column="tienda-en-linea">Catálogo de productos</td></tr><tr><th scope="row">CORREO</th><td data-plan-column="web-esencial">5 cuentas</td><td data-plan-column="web-completa">10 cuentas</td><td data-plan-column="tienda-en-linea">Ilimitadas</td></tr><tr><th scope="row">ENTREGA</th><td data-plan-column="web-esencial">5 días hábiles</td><td data-plan-column="web-completa">10 días hábiles</td><td data-plan-column="tienda-en-linea">10 días hábiles</td></tr><tr class="enhancement"><th scope="row">ME INTERESA</th><td data-plan-column="web-esencial"><button class="table-select" data-select-plan="web-esencial" aria-pressed="false" aria-label="Elegir Web Esencial">Elegir ↗</button></td><td data-plan-column="web-completa"><button class="table-select" data-select-plan="web-completa" aria-pressed="false" aria-label="Elegir Web Completa">Elegir ↗</button></td><td data-plan-column="tienda-en-linea"><button class="table-select" data-select-plan="tienda-en-linea" aria-pressed="false" aria-label="Elegir Tienda en línea">Elegir ↗</button></td></tr></tbody></table></div><div class="table-notes"><p>El sitio se paga una sola vez. Desde el segundo año, dominio, hospedaje y mantenimiento tienen renovación anual; el importe se confirma por separado.</p><p>La Tienda en línea incluye catálogo de productos. La pasarela de pago se evalúa y cotiza aparte. Los asistentes y automatizaciones de 3dev AI también se contratan por separado.</p></div></div></section>
<section class="section paper" data-surface="paper" id="proceso" aria-labelledby="process-title" data-scene="Así lo hacemos"><div class="wrap"><div class="process-top"><div><p class="eyebrow section-number">04 / DE TU IDEA A LA WEB</p><h2 id="process-title">Menos vueltas.<br>Más cerca de<br><span class="accent">estar en línea.</span></h2></div><ol class="steps"><li><span>01</span><div><h3>Nos cuentas qué necesitas.</h3><p>Elegimos el plan y acordamos el contenido. Para empezar: 50% de anticipo.</p></div></li><li><span>02</span><div><h3>Le damos forma a tu esencia.</h3><p>Con tu logotipo, textos e imágenes, diseñamos una experiencia que presenta tu negocio con claridad.</p></div></li><li><span>03</span><div><h3>Lo revisamos. Lo entregamos.</h3><p>Revisamos contigo el resultado y completamos la entrega con el 50% restante, contra factura.</p></div></li></ol></div><div class="faq-grid"><div><h3>Lo que conviene saber.</h3><p>Alcances claros desde la primera conversación.</p></div><div class="faq-list"><details><summary>¿En cuánto tiempo queda listo?</summary><p>Web Esencial: 5 días hábiles. Web Completa y Tienda en línea: 10 días hábiles. Antes de iniciar acordamos contigo el contenido y la fecha de entrega.</p></details><details><summary>¿Hay mensualidades por mi sitio?</summary><p>No. Dominio y hospedaje están incluidos el primer año. Después se renuevan anualmente, junto con el mantenimiento, con precio por confirmar.</p></details><details><summary>¿Qué necesito compartirles?</summary><p>Tu logotipo, los textos de cada sección y las fotografías en formato digital. Te ayudamos a ordenar esa información dentro del alcance de tu plan.</p></details><details><summary>¿Mi sitio puede atender con inteligencia artificial?</summary><p>Sí. Puedes sumar un asistente de 3dev AI. Es un producto adicional y se cotiza por separado del sitio web.</p></details></div></div></div></section>
<section class="closing" id="contacto" aria-labelledby="contact-title" data-scene="Demos el primer paso"><div class="wrap"><div class="closing-grid"><div><p class="eyebrow section-number">05 / EL SIGUIENTE CLIC ES TUYO</p><h2 id="contact-title">Que tu negocio<br>se vea tan bien<br><span class="accent">como lo haces.</span></h2></div><div class="contact-box"><label for="chosen">TU PUNTO DE PARTIDA</label><select id="chosen"><option value="">Quiero ayuda para elegir</option><option value="web-esencial">Web Esencial</option><option value="web-completa">Web Completa</option><option value="tienda-en-linea">Tienda en línea</option></select><p class="contact-summary" id="contact-summary" aria-live="polite">Te ayudamos a encontrar el plan que necesitas.</p><a id="contact-link" class="button primary" href="https://wa.me/522223576770?text=Hola%2C%203dev.%20Quiero%20una%20web%20para%20mi%20negocio.%20%C2%BFMe%20ayudan%20a%20elegir%20un%20plan%3F" target="_blank" rel="noopener noreferrer">Hablemos por WhatsApp <span aria-hidden="true">↗</span></a><p class="hint">Abre WhatsApp con tu plan listo para conversar.</p><a class="text-link" href="/contacto">O escríbenos desde el sitio ↗</a></div></div></div></section>
