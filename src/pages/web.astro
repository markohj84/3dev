@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{animation:none!important;transition:none!important}.transform-stage{transform:none!important}}
@media print{.whatsapp-float,.header,.deck,.progress-line,.enhancement,.skip{display:none!important}section{break-before:page}.hero{break-before:auto}.plan-panel{display:block!important;break-inside:avoid;margin-bottom:35px}.mock-after{clip-path:none}.section,.closing{padding-block:30px}.footer{margin-top:25px}.web-page{-webkit-print-color-adjust:exact;print-color-adjust:exact}}

</style>
<script>

const plans = JSON.parse(document.getElementById('web-plans').textContent);
const $ = selector => document.querySelector(selector);
const $$ = selector => [...document.querySelectorAll(selector)];
const motion = matchMedia('(prefers-reduced-motion: reduce)');
const scenes = $$('.web-page > section');
const tabs = $$('[role="tab"]');
let selected = null;
let presenting = false;
let revealAnimation = null;

function applyReveal(value) {
  const number = Math.max(0, Math.min(100, Number(value)));
  $('#reveal').value = number;
  $('#comparison').style.setProperty('--reveal', number + '%');
  const complete = number === 0;
  $('#inicio').classList.toggle('is-transformed', complete);
  $('#transform').setAttribute('aria-pressed', String(complete));
  $('#transform').innerHTML = complete ? 'Comparar diseño <span aria-hidden="true">↔</span>' : 'Ver demo completo <span aria-hidden="true">↗</span>';
  $('#transform-caption').textContent = complete ? 'Clínica Dental Nogal · Demo de 3dev' : 'Comparación ilustrativa · Desliza para explorar';
}
$('#reveal').addEventListener('input', event => {
  revealAnimation?.cancel();
  revealAnimation = null;
  applyReveal(event.target.value);
});
$('#transform').addEventListener('click', event => {
  const start = Number($('#reveal').value);
  const end = start === 0 ? 32 : 0;
  revealAnimation?.cancel();
  applyReveal(end);
  if (!motion.matches && event.detail > 0 && typeof $('.mock-after').animate === 'function') {
    const animation = $('.mock-after').animate([
      {clipPath: `inset(0 0 0 ${start}%)`},
      {clipPath: `inset(0 0 0 ${end}%)`}
    ], {duration: 850, easing: 'cubic-bezier(.16,1,.3,1)'});
    revealAnimation = animation;
    animation.onfinish = () => { if (revealAnimation === animation) revealAnimation = null; };
  }
});
motion.addEventListener('change', () => { if (motion.matches) { revealAnimation?.cancel(); revealAnimation = null; } });

function updateContact(id) {
  selected = plans.find(plan => plan.id === id) || null;
  $('#chosen').value = selected?.id || '';
  $('#whatsapp-float').classList.remove('is-activated');
  const message = selected
    ? `Hola, 3dev. Me interesa ${selected.name} ($${selected.setup.toLocaleString('es-MX')} MXN). Quiero dar el siguiente paso con mi sitio web.`
    : 'Hola, 3dev. Quiero una web para mi negocio. ¿Me ayudan a elegir un plan?';
  const whatsappUrl = 'https://wa.me/522223576770?text=' + encodeURIComponent(message);
  $('#contact-link').href = whatsappUrl;
  $('#whatsapp-float').href = whatsappUrl;
  $('#whatsapp-context').textContent = selected ? `${selected.name} · $${selected.setup.toLocaleString('es-MX')} MXN` : 'Tu próximo sitio empieza aquí';
  $('#contact-summary').textContent = selected ? `$${selected.setup.toLocaleString('es-MX')} MXN · Pago único · ${selected.delivery}` : 'Te ayudamos a encontrar el plan que necesitas.';
  $$('[data-plan-column]').forEach(cell => cell.dataset.selected = String(cell.dataset.planColumn === selected?.id));
  $$('[data-select-plan]').forEach(button => button.setAttribute('aria-pressed', String(button.dataset.selectPlan === selected?.id)));
}
function selectPlan(id, animate = false) {
  if (!plans.some(plan => plan.id === id)) return;
  tabs.forEach(tab => {
    const active = tab.dataset.plan === id;
    tab.setAttribute('aria-selected', String(active));
    tab.tabIndex = active ? 0 : -1;
  });
  $$('.plan-panel').forEach(panel => {
    const active = panel.id === 'panel-' + id;
    panel.hidden = !active;
    panel.classList.remove('changing');
    if (active && animate && !motion.matches) panel.classList.add('changing');
  });
  updateContact(id);
}
tabs.forEach((tab, i) => {
  tab.addEventListener('click', event => selectPlan(tab.dataset.plan, event.detail > 0));
  tab.addEventListener('keydown', event => {
    let index;
    if (event.key === 'ArrowRight') index = (i + 1) % tabs.length;
    if (event.key === 'ArrowLeft') index = (i - 1 + tabs.length) % tabs.length;
    if (event.key === 'Home') index = 0;
    if (event.key === 'End') index = tabs.length - 1;
    if (index === undefined) return;
    event.preventDefault();
    tabs[index].focus();
    selectPlan(tabs[index].dataset.plan);
  });
});
$$('[data-select-plan]').forEach(button => button.addEventListener('click', () => {
  selectPlan(button.dataset.selectPlan);
}));
$$('[data-choose]').forEach(link => link.addEventListener('click', () => {
  updateContact(link.dataset.choose);
}));
// Confirma el clic con color; conserva la navegación nativa y no implica envío.
$('#whatsapp-float').addEventListener('click', () => {
  $('#whatsapp-float').classList.add('is-activated');
});
$('#chosen').addEventListener('change', event => {
  if (event.target.value) selectPlan(event.target.value);
  else updateContact('');
});
$$('[data-device-button]').forEach(button => button.addEventListener('click', () => {
  const shell = button.closest('.demo-shell');
  shell.querySelector('.demo-frame').dataset.device = button.dataset.deviceButton;
  shell.querySelectorAll('[data-device-button]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
}));
$$('[data-preview-view]').forEach(button => button.addEventListener('click', () => {
  const content = button.closest('.demo-content');
  content.querySelectorAll('[data-view]').forEach(view => view.hidden = view.dataset.view !== button.dataset.previewView);
  content.querySelectorAll('[data-preview-view]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
}));
$$('[data-category-button]').forEach(button => button.addEventListener('click', () => {
  const content = button.closest('.demo-content');
  content.querySelectorAll('[data-category]').forEach(product => product.hidden = button.dataset.categoryButton !== 'todos' && product.dataset.category !== button.dataset.categoryButton);
  content.querySelectorAll('[data-category-button]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
}));
function currentScene() {
  let index = 0;
  scenes.forEach((scene, i) => { if (scene.getBoundingClientRect().top < innerHeight * .45) index = i; });
  return index;
}
function updateProgress() {
  const index = currentScene();
  $('#previous').disabled = index === 0;
  $('#next').disabled = index === scenes.length - 1;
  const label = String(index + 1).padStart(2, '0') + ' / ' + scenes[index].dataset.scene;
  if ($('#scene-label').textContent !== label) $('#scene-label').textContent = label;
  const distance = document.documentElement.scrollHeight - innerHeight;
  document.documentElement.style.setProperty('--progress', distance > 0 ? Math.max(0, Math.min(1, scrollY / distance)) : 0);
}
function moveScene(delta, keyboard = false) {
  const index = Math.max(0, Math.min(scenes.length - 1, currentScene() + delta));
  scenes[index].scrollIntoView({behavior: motion.matches || keyboard ? 'instant' : 'smooth'});
}
$('#presentation').addEventListener('click', () => {
  presenting = !presenting;
  $('#web-page').classList.toggle('presenting', presenting);
  $('#presentation').setAttribute('aria-pressed', String(presenting));
  $('#presentation').textContent = presenting ? 'Salir de presentación ×' : 'Presentar ↗';
  $('#deck').hidden = !presenting;
  updateProgress();
});
$('#exit-presentation').addEventListener('click', () => $('#presentation').click());
$('#previous').addEventListener('click', event => moveScene(-1, event.detail === 0));
$('#next').addEventListener('click', event => moveScene(1, event.detail === 0));
window.addEventListener('keydown', event => {
  if (!presenting || event.altKey || event.ctrlKey || event.metaKey || event.target.closest('input,select,textarea,button,a,summary,[contenteditable]')) return;
  if (['ArrowRight', 'PageDown', 'ArrowLeft', 'PageUp'].includes(event.key)) {
    event.preventDefault();
    moveScene(['ArrowRight', 'PageDown'].includes(event.key) ? 1 : -1, true);
  }
});
let pendingScroll = false;
window.addEventListener('scroll', () => {
  if (!pendingScroll) {
    pendingScroll = true;
    requestAnimationFrame(() => { updateProgress(); pendingScroll = false; });
  }
}, {passive: true});
window.addEventListener('resize', updateProgress);
applyReveal(0);
selectPlan('web-esencial');
// Browsing a sample does not mean the visitor has chosen to buy it.
updateContact('');
updateProgress();
$('#web-page').classList.remove('no-js');


</script>
