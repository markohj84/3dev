.web-page,.web-page.presenting{padding-bottom:calc(100px + env(safe-area-inset-bottom,0px))}
.whatsapp-float{position:fixed;z-index:30;right:24px;bottom:calc(20px + env(safe-area-inset-bottom,0px));display:flex;align-items:center;gap:16px;min-height:72px;padding:14px 18px;background-color:var(--surface-elev);background-image:linear-gradient(130deg,var(--glass-cta-highlight),transparent 65%);color:var(--text-primary);border:1px solid var(--glass-cta-border);border-radius:var(--r-xl);box-shadow:0 12px 32px var(--shadow),inset 0 1px 0 var(--glass-cta-highlight);transition:transform 160ms var(--ease-out),background-color var(--m-fast) ease,border-color var(--m-fast) ease,color var(--m-fast) ease}
@supports ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){.whatsapp-float{background-color:var(--glass-cta-bg);-webkit-backdrop-filter:blur(20px) saturate(140%);backdrop-filter:blur(20px) saturate(140%)}}
