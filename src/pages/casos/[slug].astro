---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import '../../styles/editorial.css';
export async function getStaticPaths() { return (await getCollection('casos',({data})=>!data.draft)).map(caso=>({params:{slug:caso.id},props:{caso}})); }
const { caso } = Astro.props;
const c = caso.data;
---
<BaseLayout title={`${c.title} — caso 3dev`} description={c.description}><div class="editorial-page">
 <section class="page-intro container"><p class="page-label"><a href="/casos">← proyectos</a> / {c.year}</p><h1>{c.title}<span class="accent">.</span></h1><p class="lead">{c.description}</p><div class="case-caption"><span>{c.industry} / {c.tags.join(' · ')}</span>{c.siteUrl && <a href={c.siteUrl} target="_blank" rel="noopener noreferrer">Visitar el sitio ↗</a>}</div></section>
 <section class="paper-section" data-surface="paper"><div class="container">
  {c.cover && <figure><div class="case-screen"><Image src={c.cover} alt={c.coverAlt ?? c.title} widths={[640,960,1280,1600]} sizes="90vw" width={1600} format="webp" quality={85} loading="eager" /></div><figcaption class="case-caption"><span>{c.title} / experiencia para negocios</span><span>captura del sitio · julio 2026</span></figcaption></figure>}
  {c.challengeTitle && <div class="case-story"><div><span class="story-label">01 / el contexto</span><h2>{c.challengeTitle}</h2></div><p>{c.challengeLead}</p></div>}
  {c.solutionTitle && <div class="case-story"><div><span class="story-label">02 / la experiencia</span><h2>{c.solutionTitle}</h2></div><p>{c.solutionLead}</p></div>}
  {c.solutionBlocks && <div class="solution-list">{c.solutionBlocks.map(block=><article><span class="story-label">{block.tag}</span><h3>{block.title}</h3><p>{block.desc}</p></article>)}</div>}
  {c.resultsVerified && c.metrics.length>0 && <section class="case-story"><h2>Resultados.</h2><dl>{c.metrics.map(metric=><div><dt>{metric.label}</dt><dd>{metric.value}</dd>{metric.desc && <p>{metric.desc}</p>}</div>)}</dl></section>}
  {c.testimonialApproved && c.testimonial && <blockquote>{c.testimonial.quote}<footer>{c.testimonial.name} · {c.testimonial.role}</footer></blockquote>}
 </div></section>
 <section class="page-cta"><div class="container"><h2>El siguiente puede ser tu proyecto.</h2><a class="editorial-link" href="/contacto">Hablemos <span aria-hidden="true">↗</span></a></div></section>
</div></BaseLayout>
<style>
 .accent {color:var(--accent-default);}.page-intro .case-caption {margin-top:var(--s-10);}.case-screen {aspect-ratio:1.65;}.case-story {display:grid;grid-template-columns:1fr 1fr;gap:var(--s-16);padding-top:var(--s-16);margin-top:var(--s-16);border-top:1px solid var(--border-default);}.story-label {display:block;font:11px var(--font-mono);color:var(--text-secondary);margin-bottom:var(--s-6);}.case-story>p {font-size:20px;line-height:1.65;color:var(--text-secondary);padding-top:var(--s-10);}.solution-list {display:grid;grid-template-columns:repeat(3,1fr);gap:var(--s-8);margin-top:var(--s-16);}.solution-list article {border-top:1px solid var(--border-default);padding-top:var(--s-6);}.solution-list h3 {font-size:26px;}.solution-list p {font-size:15px;line-height:1.7;color:var(--text-secondary);margin-top:var(--s-4);}@media(max-width:47.99rem){.case-screen {aspect-ratio:1;}.case-story {grid-template-columns:1fr;gap:var(--s-6);margin-top:var(--s-10);padding-top:var(--s-10);}.case-story>p {padding-top:0;font-size:17px;}.solution-list {grid-template-columns:1fr;gap:var(--s-8);}}
</style>
