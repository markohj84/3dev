/* ===== BUTTONS ===== */
.btn-primary {
  font-family: var(--font-mono); font-size: 13px; font-weight: 500;
  background: var(--grad-accent); color: var(--text-on-accent);
  padding: 15px 26px; border-radius: 7px;
  position: relative; overflow: hidden;
  transition: transform var(--m-fast), box-shadow var(--m-base);
  box-shadow: 0 4px 20px rgba(93,196,164,0.25), inset 0 1px 0 rgba(255,255,255,0.15);
  display: inline-flex; align-items: center; gap: 10px;
  text-decoration: none;
}
.btn-primary::before {
  content: ''; position: absolute; top: 0; left: -100%;
  width: 100%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.30), transparent);
  transition: left 700ms var(--ease-out);
}
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(93,196,164,0.45); }
.btn-primary:hover::before { left: 100%; }
.btn-secondary {
  font-family: var(--font-mono); font-size: 13px;
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur);
  border: 1px solid var(--glass-border);
  color: var(--text-primary);
  padding: 15px 22px; border-radius: 7px;
  display: inline-flex; align-items: center; gap: 10px;
  transition: border-color var(--m-base), transform var(--m-fast);
  text-decoration: none;
}
.btn-secondary:hover { border-color: var(--glass-border-accent); transform: translateY(-2px); }

/* ===== FINAL CTA ===== */
.final-cta {
  padding: 140px 0;
  position: relative;
  overflow: hidden;
}
.final-cta-bg {
