  .featured-content { padding: 32px 28px; }
  .featured-metrics { grid-template-columns: 1fr 1fr; }
}
</style>

<script>
(function() {
  const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip[data-filter]');
  const featured = document.getElementById('featured-card') as HTMLElement | null;
  const cards = document.querySelectorAll<HTMLElement>('.case-card[data-tags]');
  const countEl = document.getElementById('filter-count');

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      chips.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');

      const f = chip.dataset.filter as string;
      let visible = 0;

      // filter featured section
      if (featured) {
        const ftags = (featured.dataset.tags || '').split(',');
        const show = f === 'todos' || ftags.includes(f);
        featured.style.display = show ? '' : 'none';
        if (show) visible++;
      }

      // filter case grid cards
      cards.forEach(card => {
        const ctags = (card.dataset.tags || '').split(',');
        const isCs  = card.classList.contains('coming-soon');
        const show  = f === 'todos' || isCs || ctags.includes(f);
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      if (countEl) {
        const total = (featured ? 1 : 0) + cards.length;
        countEl.textContent =
          String(visible).padStart(2,'0') + ' / ' +
          String(total).padStart(2,'0') + ' proyectos';
      }
    });
  });
})();
</script>
