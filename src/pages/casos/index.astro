}
.cta-actions { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }

/* ===== ANIMATIONS ===== */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0);    }
}

/* ===== RESPONSIVE ===== */
@media (max-width: 1024px) {
  .featured-card { grid-template-columns: 1fr; }
  .featured-visual { min-height: 360px; border-left: none; border-top: 1px solid var(--glass-border); }
  .featured-content { padding: 40px 36px; }
  .cases-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 720px) {
  .page-hero { padding: 130px 0 40px; }
  .filters { width: 100%; }
  .filter-count { display: none; }
  .cases-grid { grid-template-columns: 1fr; }
  .disclosure-band { flex-direction: column; align-items: flex-start; }
  .cta-actions { flex-direction: column; align-items: stretch; }
