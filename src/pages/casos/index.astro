---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import '../../styles/editorial.css';
const cases = await getCollection('casos',({data})=>!data.draft);
---
<BaseLayout title="Proyectos — 3dev" description="Trabajo seleccionado de 3dev. Diseño y tecnología aplicados a productos digitales."><div class="editorial-page">
 <section class="page-intro container"><p class="page-label">trabajo seleccionado / {String(cases.length).padStart(2,'0')}</p><h1>Menos promesas.<br />Más producto.</h1><p class="lead">Una selección de lo que construimos. Cada proyecto empieza con un problema concreto y toma su propia forma.</p></section>
 <section class="paper-section" data-surface="paper" aria-label="Casos de estudio"><div class="container">{cases.map((caso,i)=><article class="case-entry"><div class="case-heading"><span class="number">{String(i+1).padStart(2,'0')} /</span><h2><a href={`/casos/${caso.id}`}>{caso.data.title} <span aria-hidden="true">↗</span></a></h2><span class="case-tags">{caso.data.tags.join(' · ')}</span></div>{caso.data.cover && <a class="case-screen" href={`/casos/${caso.id}`}><Image src={caso.data.cover} alt={caso.data.coverAlt ?? caso.data.title} widths={[640,960,1280,1600]} sizes="90vw" width={1600} format="webp" quality={85} /></a>}<div class="case-summary"><p>{caso.data.description}</p><a class="editorial-link" href={`/casos/${caso.id}`}>Explorar el caso <span aria-hidden="true">↗</span></a></div></article>)}</div></section>
 <section class="page-cta"><div class="container"><h2>¿Qué podemos construir contigo?</h2><a href="/contacto" class="editorial-link">Hablemos <span aria-hidden="true">↗</span></a></div></section>
</div></BaseLayout>
<style>
 .case-entry + .case-entry { margin-top: var(--section-space); }.case-heading { display:flex;align-items:baseline;gap:var(--s-6);margin-bottom:var(--s-8); }.number,.case-tags { font:11px var(--font-mono); }.case-tags { margin-left:auto; }.case-heading h2 {font-size:clamp(40px,6vw,80px);}.case-heading h2 span {font-weight:400;}.case-screen {aspect-ratio:1.85;}.case-summary {display:flex;align-items:start;justify-content:space-between;gap:var(--s-8);margin-top:var(--s-8);}.case-summary p {max-width:45ch;font-size:18px;line-height:1.6;color:var(--text-secondary);}.case-summary a {flex-shrink:0;}@media(max-width:47.99rem){.case-heading {flex-wrap:wrap;gap:var(--s-3);}.case-tags {margin-left:0;width:100%;}.case-screen {aspect-ratio:1.1;}.case-summary {flex-direction:column;}.case-summary p {font-size:16px;}}
</style>
