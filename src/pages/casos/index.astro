---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allCasos = await getCollection('casos', ({ data }) => !data.draft);
const featured  = allCasos.find(c => c.data.featured);
const others    = allCasos.filter(c => !c.data.featured);

const publishedCount = allCasos.length;
const COMING_SOON    = 3;
const totalCount     = publishedCount + COMING_SOON;
---

<BaseLayout
  title="Proyectos — 3dev"
  description="Productos digitales en producción. Pocos casos, bien contados, cada uno con resultados medibles."
>

  <div class="grid-bg"></div>

  <!-- ===== PAGE HERO ===== -->
  <section class="page-hero">
    <div class="page-hero-bg"></div>
    <div class="container">
      <div class="page-hero-content">
        <div class="page-eyebrow">proyectos</div>
        <h1 class="page-title">Productos digitales <span class="accent">en producción.</span></h1>
        <p class="page-sub">Pocos casos, bien contados. Cada uno es un producto en operación real, con métricas verificables. Si no aparece aquí, es porque no lo construimos o porque el cliente prefirió que no lo mostráramos.</p>
      </div>
    </div>
  </section>

  <!-- ===== FILTERS ===== -->
  <section class="filters-section">
    <div class="container">
      <div class="filters">
        <span class="filter-label">filtrar:</span>
        <button class="filter-chip active" data-filter="todos">todos</button>
        <button class="filter-chip" data-filter="brand">brand/</button>
        <button class="filter-chip" data-filter="product">product/</button>
        <button class="filter-chip" data-filter="ai">ai/</button>
        <span class="filter-count" id="filter-count">
          {String(publishedCount).padStart(2,'0')} / {String(totalCount).padStart(2,'0')} proyectos
        </span>
      </div>
    </div>
  </section>

  <!-- ===== FEATURED CASE ===== -->
  {featured && (
    <section
      class="featured-section reveal"
      data-tags={featured.data.tags.join(',')}
      id="featured-card"
    >
      <div class="container">
        <a href={`/casos/${featured.id}`} class="featured-card">
          <div class="featured-content">
            <div class="featured-badge">
              <span class="featured-badge-dot"></span>
              <span>caso destacado · activo</span>
            </div>
            <div class="featured-tags">
              {featured.data.tags.map(t => (
                <span class="tag">{t}/</span>
              ))}
            </div>
            <h2 class="featured-title">{featured.data.title} — sistema de producto digital con IA</h2>
            <p class="featured-desc">{featured.data.description}</p>
            <div class="featured-metrics">
              {featured.data.metrics.map(m => (
                <div>
                  <div class="metric-label">{m.label}</div>
                  <div class={`metric-value${m.accent ? ' accent' : ''}`}>{m.value}</div>
                </div>
              ))}
            </div>
            <span class="featured-link">Ver caso completo <span>→</span></span>
          </div>

          <!-- device mockup — decorative -->
          <div class="featured-visual">
            <div class="device-cluster">
              <div class="fc-laptop">
                <div class="fc-laptop-screen">
                  <div class="fc-nav">
                    <div class="fc-dot"></div><div class="fc-dot"></div><div class="fc-dot"></div>
                    <div class="fc-url">lascholulas.com/admin</div>
                  </div>
                  <div class="fc-content">
                    <div class="fc-eyebrow">PANEL · HOY</div>
                    <div class="fc-headline">Buenas tardes,<br/>Carlos</div>
                    <div class="fc-stats">
                      <div class="fc-stat">
                        <div class="fc-stat-label">RESERVAS</div>
                        <div class="fc-stat-val">47</div>
                        <div class="fc-stat-trend">↑ 12%</div>
                      </div>
                      <div class="fc-stat">
                        <div class="fc-stat-label">IA ATENDIÓ</div>
                        <div class="fc-stat-val green">38</div>
                        <div class="fc-stat-trend">81% auto</div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="fc-phone">
                <div class="fc-phone-screen">
                  <div class="fc-phone-notch"></div>
                  <div class="fc-phone-eyebrow">RESERVAS</div>
                  <div class="fc-phone-title">Hoy</div>
                  <div class="fc-phone-card">
                    <div class="fc-phone-label">CONFIRMADAS</div>
                    <div class="fc-phone-val">47</div>
                  </div>
                  <div class="fc-phone-card">
                    <div class="fc-phone-label">EN COLA</div>
                    <div class="fc-phone-val secondary">8</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- ===== CASES GRID (coming soon + others) ===== -->
  <section class="cases-section">
    <div class="container">
      <div class="cases-grid reveal-stagger" id="cases-grid">

        <!-- Published non-featured cases (future) -->
        {others.map(caso => (
          <article
            class="case-card"
            data-tags={caso.data.tags.join(',')}
          >
            <div class="case-visual">
              <div class="case-mesh"></div>
            </div>
            <div class="case-content">
              <div class="case-tags-row">
                {caso.data.tags.map(t => <span class="tag-sm">{t}/</span>)}
              </div>
              <h3 class="case-title-sm">{caso.data.title}</h3>
              <p class="case-desc-sm">{caso.data.description}</p>
              <div class="case-meta">
                <span>{caso.data.client} · {caso.data.year}</span>
                <a href={`/casos/${caso.id}`} class="case-arrow">ver caso <span>→</span></a>
              </div>
            </div>
          </article>
        ))}

        <!-- Coming soon cards — always shown -->
        <article class="case-card coming-soon" data-tags="product,ai">
          <div class="case-visual">
            <div class="cs-eyebrow"><span class="dot"></span>EN CONSTRUCCIÓN</div>
          </div>
          <div class="cs-content">
            <div class="case-tags-row">
              <span class="tag-sm">product/</span>
              <span class="tag-sm">ai/</span>
            </div>
            <div class="cs-title">Proyecto en desarrollo activo</div>
            <div class="cs-meta">caso público · Q3 2026</div>
          </div>
        </article>

        <article class="case-card coming-soon" data-tags="brand,product">
          <div class="case-visual">
            <div class="cs-eyebrow"><span class="dot"></span>EN DISCOVERY</div>
          </div>
          <div class="cs-content">
            <div class="case-tags-row">
              <span class="tag-sm">brand/</span>
              <span class="tag-sm">product/</span>
            </div>
            <div class="cs-title">Próximo arranque</div>
            <div class="cs-meta">caso público · Q4 2026</div>
          </div>
        </article>

        <article class="case-card coming-soon" data-tags="product,ai">
          <div class="case-visual">
            <div class="cs-eyebrow"><span class="dot"></span>BAJO NDA</div>
          </div>
          <div class="cs-content">
            <div class="case-tags-row">
              <span class="tag-sm">product/</span>
              <span class="tag-sm">ai/</span>
            </div>
            <div class="cs-title">Cliente bajo confidencialidad</div>
            <div class="cs-meta">disponible bajo solicitud</div>
          </div>
        </article>

      </div>

      <!-- Disclosure band -->
      <div class="disclosure-band reveal">
        <div class="disclosure-text">
          <strong>Por qué solo ves un caso público:</strong> nos reposicionamos en 2026 hacia Brand + Product + AI integrado. Los proyectos previos a este pivote no representan lo que hacemos hoy. Estamos curando con disciplina: cada nuevo caso pasa por filtros estrictos antes de hacerse público.
        </div>
        <a href="/contacto" class="btn-secondary">
          <span>Hablar sobre tu proyecto →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== FINAL CTA ===== -->
  <section class="final-cta">
    <div class="final-cta-bg"></div>
    <div class="container">
      <div class="final-cta-content reveal">
        <h2 class="cta-title">¿Tu proyecto puede ser <span class="accent">el próximo?</span></h2>
        <p class="cta-sub">Si encaja con lo que hacemos, podemos arrancar en 1-2 meses. Si no, te lo decimos honestamente en 24 horas.</p>
        <div class="cta-actions">
          <a href="/contacto" class="btn-primary">
            <span>Agendar conversación</span>
            <span>→</span>
          </a>
          <a href="/capacidades" class="btn-secondary">
            <span>Ver capacidades</span>
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
/* ===== GRID BG ===== */
.grid-bg {
  position: fixed; inset: 0; z-index: 0; pointer-events: none;
  background-image:
    linear-gradient(var(--border-sub) 1px, transparent 1px),
    linear-gradient(90deg, var(--border-sub) 1px, transparent 1px);
  background-size: 80px 80px;
  mask-image: radial-gradient(ellipse 80% 60% at center, black 30%, transparent 80%);
}

/* ===== PAGE HERO ===== */
.page-hero {
  padding: 180px 0 60px;
  position: relative;
  overflow: hidden;
}
.page-hero-bg {
  position: absolute; inset: 0; pointer-events: none;
  background: radial-gradient(ellipse 900px 500px at 30% 50%, rgba(93,196,164,0.08) 0%, transparent 60%);
}
.page-hero-content { position: relative; z-index: 2; max-width: 820px; }
.page-hero-content > * {
  opacity: 0;
  animation: fadeUp 800ms var(--ease-out) forwards;
}
.page-hero-content > *:nth-child(1) { animation-delay: 100ms; }
.page-hero-content > *:nth-child(2) { animation-delay: 200ms; }
.page-hero-content > *:nth-child(3) { animation-delay: 320ms; }

.page-eyebrow {
  display: inline-flex; align-items: center; gap: 10px;
  font-family: var(--font-mono); font-size: 11px;
  letter-spacing: 1.8px; color: var(--accent-default);
  text-transform: lowercase; margin-bottom: 24px;
  padding: 6px 14px;
  background: rgba(93,196,164,0.08);
  border: 1px solid var(--glass-border-accent);
  border-radius: 100px;
}
.page-title {
  font-size: clamp(40px, 5.5vw, 68px);
  font-weight: 600; line-height: 1.05;
  letter-spacing: -2.5px; margin-bottom: 28px;
  color: var(--text-primary);
}
.page-title .accent { color: var(--accent-default); }
.page-sub {
  font-size: clamp(17px, 1.4vw, 20px);
  line-height: 1.55; color: var(--text-secondary);
  max-width: 580px;
}

/* ===== FILTERS ===== */
.filters-section { padding: 32px 0 48px; }
.filters {
  display: flex; gap: 8px;
  flex-wrap: wrap; align-items: center;
  padding: 14px 18px;
  background: var(--glass-bg-subtle);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1px solid var(--glass-border);
  border-radius: 12px;
  width: fit-content;
}
.filter-label {
  font-family: var(--font-mono); font-size: 11px;
  color: var(--text-tertiary); letter-spacing: 0.5px;
  margin-right: 8px;
}
.filter-chip {
  font-family: var(--font-mono); font-size: 11px;
  color: var(--text-secondary);
  padding: 7px 14px; border-radius: 6px;
  border: 1px solid var(--border-sub);
  cursor: pointer;
  transition: all var(--m-fast);
  letter-spacing: 0.3px;
}
.filter-chip:hover {
  color: var(--text-primary);
  border-color: var(--glass-border-accent);
}
.filter-chip.active {
  background: var(--grad-accent);
  color: var(--text-on-accent);
  border-color: transparent;
  font-weight: 500;
}
.filter-count {
  margin-left: 12px;
  font-family: var(--font-mono); font-size: 10px;
  color: var(--text-tertiary); letter-spacing: 1px;
  padding-left: 16px;
  border-left: 1px solid var(--border-sub);
}

/* ===== FEATURED CARD ===== */
.featured-section { padding: 0 0 80px; }
.featured-card {
  display: grid;
  grid-template-columns: 1fr 1.3fr;
  gap: 0;
  background: var(--glass-bg-subtle);
  border: 1px solid var(--glass-border);
  border-radius: 24px;
  overflow: hidden;
  position: relative;
  transition: border-color var(--m-base);
  cursor: pointer;
  text-decoration: none;
  color: inherit;
}
.featured-card:hover { border-color: var(--glass-border-accent); }
.featured-card::before {
  content: '';
  position: absolute;
  inset: -1px;
  border-radius: 24px;
  background: var(--grad-card-border);
  z-index: -1;
  opacity: 0.6;
}

.featured-content { padding: 56px 56px 52px; }
.featured-badge {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--font-mono); font-size: 10px;
  letter-spacing: 1.5px; color: var(--accent-default);
  text-transform: uppercase;
  padding: 5px 10px;
  background: rgba(93,196,164,0.10);
  border: 1px solid rgba(93,196,164,0.20);
  border-radius: 4px;
  margin-bottom: 24px;
}
.featured-badge-dot {
  width: 6px; height: 6px;
  background: var(--accent-default); border-radius: 50%;
  box-shadow: 0 0 8px var(--accent-default);
  animation: pulse 2s ease-in-out infinite;
}
.featured-tags {
  display: flex; gap: 6px; margin-bottom: 24px;
}
.tag {
  font-family: var(--font-mono); font-size: 10px;
  color: var(--accent-default);
  background: rgba(93,196,164,0.08);
  padding: 5px 10px; border-radius: 4px;
  letter-spacing: 0.5px;
  border: 1px solid rgba(93,196,164,0.15);
}
.featured-title {
  font-size: clamp(28px, 3.2vw, 40px);
  font-weight: 600; line-height: 1.1;
  letter-spacing: -1.4px; margin-bottom: 20px;
  color: var(--text-primary);
}
.featured-desc {
  font-size: 15px; line-height: 1.65;
  color: var(--text-secondary);
  margin-bottom: 36px;
}
.featured-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  padding: 24px 0;
  border-top: 1px solid var(--border-default);
  border-bottom: 1px solid var(--border-default);
  margin-bottom: 32px;
}
.metric-label {
  font-family: var(--font-mono); font-size: 10px;
  letter-spacing: 0.8px; color: var(--text-tertiary);
  margin-bottom: 6px; text-transform: uppercase;
}
.metric-value {
  font-size: 28px; font-weight: 600;
  letter-spacing: -1px;
  font-feature-settings: 'tnum';
  color: var(--text-primary);
}
.metric-value.accent {
  background: var(--grad-accent);
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
}
.featured-link {
  font-family: var(--font-mono); font-size: 13px;
  color: var(--accent-default);
  display: inline-flex; align-items: center; gap: 8px;
  transition: gap var(--m-base);
}
.featured-card:hover .featured-link { gap: 14px; }

/* ===== FEATURED VISUAL ===== */
.featured-visual {
  background: var(--surface-sunken);
  border-left: 1px solid var(--glass-border);
  position: relative;
  overflow: hidden;
  min-height: 480px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px;
}
.featured-visual::before {
  content: '';
  position: absolute; inset: 0;
  background: var(--grad-mesh);
  opacity: 0.4;
}

/* device cluster */
.device-cluster {
  position: relative;
  width: 100%;
  max-width: 460px;
}
.fc-laptop {
  width: 100%;
  background: var(--ink-900);
  border-radius: 12px 12px 4px 4px;
  border: 1px solid rgba(255,255,255,0.08);
  padding: 8px;
  box-shadow:
    0 30px 60px rgba(0,0,0,0.5),
    0 0 60px rgba(93,196,164,0.10),
    inset 0 0 0 1px rgba(255,255,255,0.04);
  position: relative;
  transform: rotateY(-6deg) rotateX(2deg);
  transform-origin: center;
  transition: transform var(--m-slow);
  z-index: 1;
}
.featured-card:hover .fc-laptop { transform: rotateY(-3deg) rotateX(1deg); }
.fc-laptop::before {
  content: '';
  position: absolute; top: 0; left: 50%;
  transform: translateX(-50%);
  width: 60px; height: 4px;
  background: rgba(255,255,255,0.1);
  border-radius: 0 0 4px 4px;
}
.fc-laptop-screen {
  background: var(--surface-bg);
  border-radius: 7px;
  aspect-ratio: 16/10;
  overflow: hidden;
}
.fc-nav {
  height: 28px;
  background: rgba(5,11,9,0.6);
  border-bottom: 1px solid var(--border-sub);
  display: flex; align-items: center;
  padding: 0 12px; gap: 6px;
}
.fc-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--ink-600); }
.fc-url {
  flex: 1; text-align: center;
  font-family: var(--font-mono); font-size: 8px;
  color: var(--text-tertiary); letter-spacing: 0.3px;
}
.fc-content { padding: 16px 20px; }
.fc-eyebrow {
  font-family: var(--font-mono); font-size: 7px;
  color: var(--accent-default); letter-spacing: 1.2px;
  margin-bottom: 8px;
}
.fc-headline {
  font-size: 14px; font-weight: 600;
  letter-spacing: -0.3px; line-height: 1.15;
  margin-bottom: 14px;
  color: var(--text-primary);
}
.fc-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
.fc-stat {
  background: rgba(26,51,41,0.45);
  border: 1px solid var(--border-sub);
  border-radius: 5px;
  padding: 10px 12px;
}
.fc-stat-label {
  font-family: var(--font-mono); font-size: 6px;
  color: var(--text-tertiary); letter-spacing: 0.6px;
  margin-bottom: 4px;
}
.fc-stat-val {
  font-size: 18px; font-weight: 600;
  letter-spacing: -0.4px;
  color: var(--text-primary);
}
.fc-stat-val.green { color: var(--accent-default); }
.fc-stat-trend {
  font-family: var(--font-mono); font-size: 6px;
  color: var(--accent-default); margin-top: 3px;
}

/* phone */
.fc-phone {
  position: absolute;
  right: -10px; bottom: -30px;
  width: 100px; height: 200px;
  background: var(--ink-900);
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,0.10);
  padding: 5px;
  box-shadow:
    0 20px 40px rgba(0,0,0,0.6),
    0 0 30px rgba(93,196,164,0.15);
  transform: rotate(8deg);
  transition: transform var(--m-slow);
  z-index: 2;
}
.featured-card:hover .fc-phone { transform: rotate(4deg) translateY(-4px); }
.fc-phone-screen {
  background: var(--surface-bg);
  border-radius: 10px;
  height: 100%; padding: 12px 10px;
  position: relative;
  overflow: hidden;
}
.fc-phone-notch {
  position: absolute; top: 3px; left: 50%;
  transform: translateX(-50%);
  width: 36px; height: 10px;
  background: var(--ink-900);
  border-radius: 0 0 6px 6px;
}
.fc-phone-eyebrow {
  font-family: var(--font-mono); font-size: 6px;
  color: var(--accent-default); letter-spacing: 0.8px;
  margin-top: 18px; margin-bottom: 6px;
}
.fc-phone-title {
  font-size: 11px; font-weight: 600;
  letter-spacing: -0.2px; line-height: 1.15;
  margin-bottom: 10px;
  color: var(--text-primary);
}
.fc-phone-card {
  background: rgba(26,51,41,0.45);
  border: 1px solid var(--border-sub);
  border-radius: 5px;
  padding: 6px 8px; margin-bottom: 5px;
}
.fc-phone-label {
  font-family: var(--font-mono); font-size: 5px;
  color: var(--text-tertiary);
  margin-bottom: 3px;
}
.fc-phone-val {
  font-size: 11px; font-weight: 600;
  color: var(--accent-default);
}
.fc-phone-val.secondary { color: var(--text-primary); }

/* ===== CASES GRID ===== */
.cases-section { padding: 0 0 100px; }
.cases-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}
.case-card {
  background: var(--glass-bg-subtle);
  border: 1px solid var(--glass-border);
  border-radius: 16px;
  overflow: hidden;
  transition: border-color var(--m-base), transform var(--m-base);
  display: flex;
  flex-direction: column;
}
.case-card:not(.coming-soon) {
  cursor: pointer;
}
.case-card:not(.coming-soon):hover {
  border-color: var(--glass-border-accent);
  transform: translateY(-3px);
}
.case-card.coming-soon { border-style: dashed; }
.case-visual {
  aspect-ratio: 16/10;
  position: relative;
  overflow: hidden;
  background: var(--surface-sunken);
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1px solid var(--glass-border);
}
.case-visual::before {
  content: '';
  position: absolute; inset: 0;
  background: var(--grad-mesh); opacity: 0.5;
}
.case-mesh {
  position: absolute; inset: 0;
  background: var(--grad-mesh); opacity: 0.5;
}
.case-card.coming-soon .case-visual {
  background:
    repeating-linear-gradient(
      45deg,
      rgba(93,196,164,0.025),
      rgba(93,196,164,0.025) 10px,
      transparent 10px,
      transparent 20px
    ),
    var(--surface-sunken);
}
.cs-eyebrow {
  font-family: var(--font-mono); font-size: 10px;
  color: var(--text-tertiary);
  letter-spacing: 2px; text-align: center;
  position: relative; z-index: 2;
}
.cs-eyebrow .dot {
  display: inline-block;
  width: 6px; height: 6px;
  background: var(--accent-default);
  border-radius: 50%;
  margin-right: 8px;
  animation: pulse 2s ease-in-out infinite;
  vertical-align: middle;
}

.case-content { padding: 20px 22px 22px; }
.cs-content { padding: 20px 22px 22px; opacity: 0.7; }
.case-tags-row { display: flex; gap: 4px; margin-bottom: 12px; flex-wrap: wrap; }
.tag-sm {
  font-family: var(--font-mono); font-size: 9px;
  color: var(--accent-default);
  background: rgba(93,196,164,0.08);
  padding: 3px 7px; border-radius: 3px;
  letter-spacing: 0.4px;
