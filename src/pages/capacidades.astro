---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Capacidades — 3dev"
  description="Brand, Product y AI como un solo sistema. Las tres capas que pensamos juntas porque no se pueden separar bien."
>

  <!-- ================================================================
       PAGE HERO
       ================================================================ -->
  <section class="page-hero">
    <div class="page-hero-bg"></div>
    <div class="container">
      <div class="page-hero-content">
        <div class="page-eyebrow">capacidades</div>
        <h1 class="page-title">
          Tres capas que <span class="text-gradient">no se venden<br>por separado.</span>
        </h1>
        <p class="page-sub">
          La mayoría de las agencias separan branding, desarrollo e IA en tres cotizaciones,
          tres equipos y tres timelines. Nosotros las pensamos juntas porque, en un producto
          digital, no se pueden separar bien.
        </p>
      </div>
    </div>
  </section>

  <!-- ================================================================
       CAPABILITY 01 — BRAND
       ================================================================ -->
  <section class="reveal">
    <div class="container">
      <div class="cap-block">
        <div class="cap-left">
          <div class="cap-number">01 / capa de marca</div>
          <span class="cap-tag">brand/</span>
          <h2 class="cap-title">Brand</h2>
          <p class="cap-summary">Estrategia, identidad y sistema de marca que aguantan crecimiento. Un sistema, no un PDF.</p>
        </div>
        <div class="cap-right">
          <p class="cap-statement">
            No diseñamos logos. Construimos sistemas de marca que escalan con la empresa
            <strong>y se traducen directamente a producto</strong>.
          </p>
          <div class="cap-bullets-grid reveal-stagger">
            <div class="cap-bullet">
              <div class="cap-bullet-icon">01</div>
              <div class="cap-bullet-title">Posicionamiento</div>
              <div class="cap-bullet-desc">Estrategia, propuesta de valor, audiencias, arquetipos y tono de voz.</div>
            </div>
            <div class="cap-bullet">
              <div class="cap-bullet-icon">02</div>
              <div class="cap-bullet-title">Identidad visual</div>
              <div class="cap-bullet-desc">Logo, paleta, tipografía, iconografía y tratamientos gráficos.</div>
            </div>
            <div class="cap-bullet">
              <div class="cap-bullet-icon">03</div>
              <div class="cap-bullet-title">Sistema de diseño</div>
              <div class="cap-bullet-desc">Design tokens, componentes y guía de uso para producto y comunicación.</div>
            </div>
            <div class="cap-bullet">
              <div class="cap-bullet-icon">04</div>
              <div class="cap-bullet-title">Manual operativo</div>
              <div class="cap-bullet-desc">Mensajes clave, casos de uso, plantillas y reglas para el equipo interno.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================
       CAPABILITY 02 — PRODUCT
       ================================================================ -->
  <section class="reveal">
    <div class="container">
      <div class="cap-block">
        <div class="cap-left">
          <div class="cap-number">02 / capa de producto</div>
          <span class="cap-tag">product/</span>
          <h2 class="cap-title">Product</h2>
          <p class="cap-summary">Diseño UI/UX y desarrollo. Construimos productos digitales con stack moderno y entrega disciplinada.</p>
        </div>
        <div class="cap-right">
          <p class="cap-statement">
            Construimos el producto digital <strong>sobre el sistema de marca</strong>
            — no como dos proyectos. Un equipo, una cadencia, una entrega.
          </p>
          <div class="cap-bullets-grid reveal-stagger">
            <div class="cap-bullet">
              <div class="cap-bullet-icon">01</div>
              <div class="cap-bullet-title">Diseño UI/UX</div>
              <div class="cap-bullet-desc">De wireframe a alta fidelidad. Prototipos navegables y validación con usuario real.</div>
            </div>
            <div class="cap-bullet">
              <div class="cap-bullet-icon">02</div>
              <div class="cap-bullet-title">Desarrollo web</div>
              <div class="cap-bullet-desc">Astro, Next.js, Sanity. Stack del 2026, no plantillas baratas.</div>
            </div>
            <div class="cap-bullet">
              <div class="cap-bullet-icon">03</div>
              <div class="cap-bullet-title">Apps móviles</div>
              <div class="cap-bullet-desc">React Native cuando el caso lo justifica. Web-first por defecto.</div>
            </div>
            <div class="cap-bullet">
              <div class="cap-bullet-icon">04</div>
              <div class="cap-bullet-title">Sistema implementado</div>
              <div class="cap-bullet-desc">Componentes y tokens del sistema de marca traducidos directo al código del producto.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================
       CAPABILITY 03 — AI
       ================================================================ -->
  <section class="reveal">
    <div class="container">
      <div class="cap-block">
        <div class="cap-left">
          <div class="cap-number">03 / capa de inteligencia</div>
          <span class="cap-tag">ai/</span>
          <h2 class="cap-title">AI</h2>
          <p class="cap-summary">Asistentes IA, automatización e integración de modelos al producto. Donde sirve, no donde es moda.</p>
        </div>
        <div class="cap-right">
          <p class="cap-statement">
            No vendemos "consultoría de IA". Integramos IA al producto
            <strong>desde el primer pixel</strong> — donde sirve, no donde es moda.
          </p>
          <div class="cap-bullets-grid reveal-stagger">
            <div class="cap-bullet">
              <div class="cap-bullet-icon">01</div>
              <div class="cap-bullet-title">Asistentes IA embebidos</div>
              <div class="cap-bullet-desc">Agentes conversacionales integrados al producto, no como widget pegado.</div>
            </div>
            <div class="cap-bullet">
              <div class="cap-bullet-icon">02</div>
              <div class="cap-bullet-title">Automatización</div>
              <div class="cap-bullet-desc">Flujos operativos que la IA atiende mientras tu equipo duerme.</div>
            </div>
            <div class="cap-bullet">
              <div class="cap-bullet-icon">03</div>
              <div class="cap-bullet-title">Integración de modelos</div>
              <div class="cap-bullet-desc">OpenAI, Anthropic, modelos abiertos. APIs robustas, no demos frágiles.</div>
            </div>
            <div class="cap-bullet">
              <div class="cap-bullet-icon">04</div>
              <div class="cap-bullet-title">Evaluación honesta</div>
              <div class="cap-bullet-desc">A veces la respuesta es "aquí IA no aporta". Te lo decimos.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================
       INTEGRATION — Stack diagram
       ================================================================ -->
  <section class="integration reveal">
    <div class="container">
      <div class="section-eyebrow">integración</div>
      <h2 class="section-title">Por qué pensarlo como <span class="accent">un sistema.</span></h2>
      <p class="section-sub">
        Las tres capas se cruzan en el punto donde vive tu producto.
        Cuando las contratas por separado, las fricciones entre proveedores te cuestan más que el ahorro.
      </p>

      <div class="integration-grid">
        <!-- Stack diagram visual -->
        <div class="stack-diagram">
          <div class="stack-connector stack-connector-1"></div>
          <div class="stack-connector stack-connector-2"></div>

          <div class="stack-layer stack-layer-1">
            <div class="stack-layer-tag">brand/</div>
            <div class="stack-layer-title">Capa de marca</div>
            <div class="stack-layer-meta">posicionamiento · identidad · sistema</div>
          </div>

          <div class="stack-layer stack-layer-2">
            <div class="stack-layer-tag">product/</div>
            <div class="stack-layer-title">Capa de producto</div>
            <div class="stack-layer-meta">UI/UX · desarrollo · stack</div>
          </div>

          <div class="stack-layer stack-layer-3">
            <div class="stack-layer-tag">ai/</div>
            <div class="stack-layer-title">Capa de inteligencia</div>
            <div class="stack-layer-meta">asistentes ia · automatización · modelos</div>
          </div>

          <div class="product-point">
            <div class="product-point-dot"></div>
            <div class="product-point-label">tu producto vive aquí</div>
          </div>
        </div>

        <!-- Copy -->
        <div class="integration-copy">
          <p>Un producto digital exitoso necesita <strong>marca clara, ejecución técnica sólida e inteligencia donde importa</strong>. Las tres cosas, al mismo tiempo, en la misma dirección.</p>
          <p>Si contratas las tres capas con tres proveedores distintos, las fricciones entre ellos te costarán más que el ahorro de "irte por separado". El branding terminará desconectado del producto; el producto, peleado con la IA; la IA, pegada al final como decoración.</p>
          <p>Por eso pensamos las tres juntas <strong>desde el día uno</strong>, con un solo equipo y una sola cadencia. Es el único modo en que un producto digital se siente coherente, no ensamblado.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================
       EXCLUSIONES — Qué no hacemos
       ================================================================ -->
  <section class="exclusions reveal">
    <div class="container">
      <div class="section-eyebrow">filtro</div>
      <h2 class="section-title">Qué <span class="accent">no hacemos.</span></h2>
      <p class="section-sub">
        Decir "no" es lo que nos permite decir "sí" bien.
        Estos son los proyectos que sistemáticamente declinamos, incluso si pagan.
      </p>

      <div class="exclusions-grid reveal-stagger">
        <div class="exclusion">
          <div class="exclusion-text">Sitios brochure de 3 a 5 páginas</div>
          <div class="exclusion-why">no es producto digital · subcontrata un freelancer bueno</div>
        </div>
        <div class="exclusion">
          <div class="exclusion-text">Community management o marketing</div>
          <div class="exclusion-why">no es nuestro oficio · te recomendamos a alguien</div>
        </div>
        <div class="exclusion">
          <div class="exclusion-text">Implementación de plantillas WordPress</div>
          <div class="exclusion-why">contradice todo lo que pensamos de stack y calidad</div>
        </div>
        <div class="exclusion">
          <div class="exclusion-text">Proyectos sin presupuesto definido</div>
          <div class="exclusion-why">no hacemos cotizaciones "para ver qué tal sale"</div>
        </div>
        <div class="exclusion">
          <div class="exclusion-text">"Solo el logo, sin estrategia"</div>
          <div class="exclusion-why">el logo sin estrategia es decoración cara</div>
        </div>
        <div class="exclusion">
          <div class="exclusion-text">"Pegar IA porque está de moda"</div>
          <div class="exclusion-why">si la IA no aporta valor real, no la integramos</div>
        </div>
      </div>

      <p class="exclusion-footer">"No" es la palabra que protege el "sí" bien dicho.</p>
    </div>
  </section>

  <!-- ================================================================
       FINAL CTA
       ================================================================ -->
  <section class="final-cta">
    <div class="final-cta-bg"></div>
    <div class="container">
      <div class="final-cta-content reveal">
        <h2 class="cta-title">¿Tienes un proyecto<br>que <span class="text-gradient">vale la pena?</span></h2>
        <p class="cta-sub">
          Cuéntanos qué quieres construir. Te decimos honestamente si encaja en lo que
          hacemos — y si no, te decimos hacia quién ir.
        </p>
        <div class="cta-actions">
          <a href="/contacto" class="btn-primary">
            <span>Agendar conversación</span>
            <span>→</span>
          </a>
          <a href="/casos" class="btn-secondary">
            <span>Ver proyectos</span>
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---- PAGE HERO ---- */
  .page-hero {
    padding: 180px 0 60px;
    position: relative;
    overflow: hidden;
  }
  .page-hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse 1000px 500px at 30% 50%, rgba(93,196,164,0.10) 0%, transparent 60%);
  }
  .page-hero-content {
    position: relative;
    z-index: 2;
    max-width: 860px;
  }
  .page-hero-content > * {
    opacity: 0;
    animation: fadeUp 800ms cubic-bezier(.22,1,.36,1) forwards;
  }
  .page-hero-content > *:nth-child(1) { animation-delay: 100ms; }
  .page-hero-content > *:nth-child(2) { animation-delay: 200ms; }
  .page-hero-content > *:nth-child(3) { animation-delay: 320ms; }

  .page-eyebrow {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.8px;
    color: var(--accent-default);
    text-transform: lowercase;
    margin-bottom: 24px;
    padding: 6px 14px;
    background: rgba(93,196,164,0.08);
    border: 1px solid var(--glass-border-accent);
    border-radius: var(--r-full);
  }
  .page-title {
    font-size: clamp(44px, 6vw, 76px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -2.8px;
    margin-bottom: 28px;
    color: var(--text-primary);
  }
  .page-sub {
    font-size: clamp(17px, 1.4vw, 20px);
    line-height: 1.55;
    color: var(--text-secondary);
    max-width: 620px;
  }

  /* ---- SECTION GENERICS ---- */
  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.8px;
    color: var(--accent-default);
    text-transform: lowercase;
    margin-bottom: 20px;
    padding: 5px 12px;
    background: rgba(93,196,164,0.08);
    border: 1px solid var(--glass-border-accent);
    border-radius: var(--r-full);
  }
  .section-title {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -1.6px;
    margin-bottom: 22px;
    max-width: 720px;
    color: var(--text-primary);
  }
  .section-title .accent { color: var(--accent-default); }
  .section-sub {
    font-size: 17px;
    line-height: 1.55;
    color: var(--text-secondary);
    max-width: 580px;
    margin-bottom: 56px;
  }

  /* ---- CAP BLOCKS ---- */
  .cap-block {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 80px;
    align-items: start;
    padding: 80px 0;
    border-top: 1px solid var(--border-sub);
    position: relative;
  }
  /* Primera sección no tiene border-top */
  section:nth-of-type(2) .cap-block {
    border-top: none;
    padding-top: 40px;
  }
  .cap-block::before {
    content: '';
    position: absolute;
    top: 80px;
    left: 0;
    width: 40px;
    height: 1px;
    background: var(--accent-default);
  }
  section:nth-of-type(2) .cap-block::before { top: 40px; }

  .cap-left {
    position: sticky;
    top: 120px;
  }
  .cap-number {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent-default);
    letter-spacing: 1.5px;
    margin-bottom: 14px;
  }
  .cap-tag {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent-default);
    letter-spacing: 0.5px;
    margin-bottom: 20px;
    display: inline-block;
    padding: 5px 12px;
    background: rgba(93,196,164,0.1);
    border-radius: 4px;
    border: 1px solid rgba(93,196,164,0.2);
  }
  .cap-title {
    font-size: clamp(32px, 3.6vw, 44px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -1.5px;
    margin-bottom: 18px;
    color: var(--text-primary);
  }
  .cap-summary {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 360px;
  }

  .cap-right {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .cap-statement {
    font-size: 18px;
    line-height: 1.55;
    color: var(--text-primary);
    padding-left: 24px;
    border-left: 2px solid var(--accent-default);
    letter-spacing: -0.2px;
  }
  .cap-statement strong {
    color: var(--text-primary);
    font-weight: 500;
  }
  .cap-bullets-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .cap-bullet {
    padding: 20px;
    background: var(--glass-bg-subtle);
    border: 1px solid var(--glass-border);
    border-radius: 10px;
    transition: border-color var(--m-base), transform var(--m-base);
  }
  .cap-bullet:hover {
    border-color: var(--glass-border-accent);
    transform: translateY(-2px);
  }
  .cap-bullet-icon {
    width: 32px;
    height: 32px;
    border-radius: 7px;
    background: linear-gradient(135deg, rgba(93,196,164,0.15), rgba(29,158,117,0.05));
    border: 1px solid rgba(93,196,164,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    font-family: var(--font-mono);
    color: var(--accent-default);
    font-size: 12px;
    font-weight: 600;
  }
  .cap-bullet-title {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.3px;
    margin-bottom: 6px;
    color: var(--text-primary);
  }
  .cap-bullet-desc {
    font-size: 12px;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  /* ---- INTEGRATION ---- */
  .integration {
    padding: 140px 0;
    position: relative;
    overflow: hidden;
  }
  .integration::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--grad-mesh);
    opacity: 0.6;
    pointer-events: none;
  }
  .integration-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 80px;
    align-items: center;
    margin-top: 32px;
    position: relative;
  }
  .stack-diagram {
    position: relative;
    height: 480px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .stack-layer {
    position: absolute;
    width: 80%;
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border-accent);
    border-radius: 12px;
    padding: 22px 28px;
    transition: transform var(--m-slow) var(--ease-out);
  }
  .stack-layer-1 { top: 40px; left: 0; }
  .stack-layer-2 { top: 170px; left: 10%; }
  .stack-layer-3 { top: 300px; left: 20%; }
  .stack-diagram:hover .stack-layer-1 { transform: translate(-8px, -8px); }
  .stack-diagram:hover .stack-layer-2 { transform: translate(0, 0); }
  .stack-diagram:hover .stack-layer-3 { transform: translate(8px, 8px); }
  .stack-layer-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--accent-default);
    letter-spacing: 1px;
    margin-bottom: 8px;
  }
  .stack-layer-title {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.4px;
    margin-bottom: 6px;
    color: var(--text-primary);
  }
  .stack-layer-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-tertiary);
    letter-spacing: 0.3px;
  }
  .stack-connector {
    position: absolute;
    width: 60%;
    left: 20%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-default), transparent);
    opacity: 0.4;
  }
  .stack-connector-1 { top: 140px; }
  .stack-connector-2 { top: 270px; }
  .product-point {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .product-point-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent-default);
    box-shadow: 0 0 30px var(--accent-default);
    position: relative;
  }
  .product-point-dot::after {
    content: '';
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 1px solid var(--accent-default);
    opacity: 0.5;
    animation: nodePulse 2.5s ease-out infinite;
  }
  .product-point-label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--accent-default);
    letter-spacing: 1.5px;
  }
  .integration-copy {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 480px;
  }
  .integration-copy p { margin-bottom: 18px; }
  .integration-copy p:last-child { margin-bottom: 0; }
  .integration-copy strong { color: var(--text-primary); font-weight: 500; }

  /* ---- EXCLUSIONES ---- */
  .exclusions { padding: 120px 0; }
  .exclusions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 24px;
  }
  .exclusion {
    padding: 24px 26px;
    background: var(--glass-bg-subtle);
    border: 1px solid var(--glass-border);
    border-left: 2px solid var(--status-danger);
    border-radius: 0 10px 10px 0;
    transition: background var(--m-base);
  }
  .exclusion:hover { background: var(--glass-bg); }
  .exclusion-text {
    font-size: 15px;
    font-weight: 500;
    color: var(--text-primary);
    letter-spacing: -0.2px;
    line-height: 1.4;
    margin-bottom: 4px;
  }
  .exclusion-why {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-tertiary);
    letter-spacing: 0.3px;
  }
  .exclusion-footer {
    margin-top: 28px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-tertiary);
    font-style: italic;
  }

  /* ---- FINAL CTA ---- */
  .final-cta {
    padding: 140px 0;
    position: relative;
    overflow: hidden;
  }
  .final-cta-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 800px 400px at 50% 100%, rgba(93,196,164,0.18) 0%, transparent 70%);
    pointer-events: none;
  }
  .final-cta-content { position: relative; max-width: 760px; }
  .cta-title {
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -2.5px;
    margin-bottom: 24px;
    color: var(--text-primary);
  }
  .cta-sub {
    font-size: 17px;
    color: var(--text-secondary);
    margin-bottom: 40px;
    max-width: 480px;
    line-height: 1.5;
  }
  .cta-actions { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }

  /* Botones inline */
  .btn-primary {
