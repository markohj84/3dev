---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/editorial.css';
const layers = [
 {n:'01',title:'Brand',subtitle:'El punto de partida.',copy:'Una identidad clara permite que todo lo demás tenga sentido. Traducimos el posicionamiento en un sistema que vive en cada pantalla, mensaje y punto de contacto.',items:[['Estrategia','Posicionamiento, propuesta de valor y tono de voz.'],['Identidad','Logo, paleta, tipografía y dirección visual.'],['Sistema','Reglas y herramientas para mantener la coherencia al crecer.']]},
 {n:'02',title:'Product',subtitle:'Lo que las personas usan.',copy:'Diseñamos la experiencia y construimos el producto como parte del mismo proceso. Del primer recorrido a la última interacción, cada decisión tiene una razón.',items:[['UX/UI','Arquitectura de información, prototipos e interfaces.'],['Desarrollo','Sitios y aplicaciones con una base técnica adecuada al proyecto.'],['Evolución','Validación, iteración y mejoras a partir del uso real.']]},
 {n:'03',title:'AI',subtitle:'Inteligencia con criterio.',copy:'Integramos modelos y automatizaciones donde aportan valor. Definimos qué pueden resolver, dónde necesitan supervisión y cómo evaluar su resultado.',items:[['Asistentes','Conversaciones conectadas con el contexto del producto.'],['Automatización','Menos trabajo repetitivo en los flujos operativos.'],['Evaluación','Calidad, límites y control humano desde el diseño.']]},
];
---
<BaseLayout title="Capacidades — 3dev" description="Marca, producto e inteligencia como un mismo sistema. Conoce el enfoque de diseño y tecnología de 3dev.">
 <div class="editorial-page">
  <section class="page-intro container"><p class="page-label">brand / product / ai</p><h1>Tres capas.<br />Una dirección.</h1><p class="lead">El valor está en cómo se conectan. Pensamos la marca, diseñamos el producto e integramos inteligencia con un mismo criterio.</p></section>
  <section class="paper-section" data-surface="paper" aria-label="Nuestras capacidades"><div class="container">
   {layers.map(layer=><article class="capability" id={layer.title.toLowerCase()}><div class="cap-title"><span>{layer.n} /</span><h2>{layer.title}<em>/</em></h2></div><div class="cap-copy"><h3>{layer.subtitle}</h3><p>{layer.copy}</p><dl>{layer.items.map(([title,desc])=><div><dt>{title}</dt><dd>{desc}</dd></div>)}</dl></div></article>)}
  </div></section>
  <section class="integration container"><p class="page-label">un sistema, desde el inicio</p><h2>La marca define.<br />El producto conecta.<br /><span>La inteligencia amplifica.</span></h2><p>Podemos empezar por una necesidad concreta. Lo importante es entender cómo encaja en el conjunto y construir sobre una base que pueda evolucionar.</p></section>
  <section class="page-cta"><div class="container"><h2>Hablemos de lo que necesitas construir.</h2><a href="/contacto" class="editorial-link">Cuéntanos tu proyecto <span aria-hidden="true">↗</span></a></div></section>
 </div>
</BaseLayout>
<style>
 .capability { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-16); padding-block: var(--s-16); border-top: 1px solid var(--border-default); }
 .capability:first-child { border-top: 0; padding-top: 0; }.capability:last-child { padding-bottom: 0; }
 .cap-title > span { font: 12px var(--font-mono); color: var(--text-secondary); }
 .cap-title h2 { font-size: clamp(52px,7vw,96px); margin-top: var(--s-6); }.cap-title em { font-style: normal; color: var(--accent-default); }
 .cap-copy > p { color: var(--text-secondary); line-height: 1.7; font-size: 16px; margin-block: var(--s-6) var(--s-8); max-width: 52ch; }
 dl > div { display: grid; grid-template-columns: 120px 1fr; gap: var(--s-5); border-top: 1px solid var(--border-default); padding-block: var(--s-5); }dt { font: 12px var(--font-mono); }dd { font-size: 14px; color: var(--text-secondary); line-height: 1.6; }
 .integration { padding-block: var(--section-space); }.integration h2 { font-size: clamp(36px,5.5vw,76px); }.integration h2 span { color: var(--accent-default); }.integration > p:last-child { max-width: 50ch; font-size: 18px; line-height: 1.7; margin-top: var(--s-8); color: var(--text-secondary); }
 @media (max-width:47.99rem) { .capability { grid-template-columns: 1fr; gap: var(--s-8); padding-block: var(--s-12); }dl > div { grid-template-columns: 1fr; gap: var(--s-2); } }
</style>
