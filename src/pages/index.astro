---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="3dev — Brand · Product · AI">
  <!-- Verificación de tokens: página temporal hasta Fase C -->
  <section style="min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:var(--s-6); padding-top:120px; padding-bottom:var(--s-16);">
    <p class="text-mono-sm" style="color:var(--accent-default)">✦ SETUP VERIFICADO</p>
    <h1 class="text-display-xl text-gradient" style="text-align:center; max-width:800px; padding:0 var(--s-8);">
      3dev — Brand · Product · AI
    </h1>
    <p style="color:var(--text-secondary); font-size:var(--text-body-lg-size); text-align:center; max-width:500px;">
      Design system v2.1 · Astro 6 · Tailwind 4
    </p>
    <div style="display:flex; gap:var(--s-4); margin-top:var(--s-4);">
      <div class="glass" style="padding:var(--s-4) var(--s-6); border-radius:var(--r-xl);">
        <span class="text-mono-sm" style="color:var(--accent-default)">tokens.css ✓</span>
      </div>
      <div class="glass" style="padding:var(--s-4) var(--s-6); border-radius:var(--r-xl);">
        <span class="text-mono-sm" style="color:var(--accent-default)">BaseLayout ✓</span>
      </div>
      <div class="glass" style="padding:var(--s-4) var(--s-6); border-radius:var(--r-xl);">
        <span class="text-mono-sm" style="color:var(--accent-default)">Tailwind 4 ✓</span>
      </div>
    </div>
  </section>
</BaseLayout>
