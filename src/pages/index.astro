---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroGrid from '../components/HeroGrid.astro';
---

<BaseLayout
  title="3dev — Brand · Product · AI"
  description="Estudio mexicano de Brand, Product y AI. Construimos productos inteligentes para empresas que ya decidieron construir el futuro."
>

  <!-- ================================================================
       HERO · GRID INFINITO 
       ================================================================ -->
  <section class="hero">
    <HeroGrid />
    <div class="container">
      <div class="hero-content">

        <!-- Badge -->
        <div class="badge">
          <span class="badge-dot"></span>
          <span>brand · product · ai</span>
          <span class="badge-divider"></span>
          <span class="badge-accent">currently building</span>
        </div>

        <!-- H1 -->
        <h1>
          La mayoría construye sitios.<br>
          <span class="accent">Nosotros construimos<br>productos inteligentes<span class="cursor"></span></span>
        </h1>

        <!-- Subtítulo -->
        <p class="hero-sub">
          Estudio mexicano de Brand, Product e IA integrada.
          Para empresas que ya decidieron no esperar el futuro, sino construirlo.
        </p>

        <!-- CTAs -->
        <div class="hero-cta">
          <a href="/casos" class="btn-primary">
            <span>Ver proyectos</span>
            <span>→</span>
          </a>
          <a href="/contacto" class="btn-secondary">
            <span>Agendar conversación</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Scroll hint -->
    <div class="scroll-hint" aria-hidden="true">
      <span>SCROLL</span>
      <span class="scroll-hint-line"></span>
    </div>
  </section>

  <!-- ================================================================
       MARQUEE — Prueba social
       ================================================================ -->
  <div class="proof">
    <div class="container">
      <p class="proof-label">Empresas que han confiado en nosotros</p>
    </div>
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        <img class="proof-logo" src="/images/logos/1_tv-azteca-04.svg" alt="TV Azteca" />
        <img class="proof-logo" src="/images/logos/3_Audi.svg" alt="Audi" />
        <img class="proof-logo" src="/images/logos/2_logo-banorte.svg" alt="Banorte" />
        <img class="proof-logo" src="/images/logos/4_seat.svg" alt="SEAT" />
        <img class="proof-logo" src="/images/logos/5_vw_logo.svg" alt="Volkswagen" />
        <!-- Duplicar para loop continuo -->
        <img class="proof-logo" src="/images/logos/1_tv-azteca-04.svg" alt="TV Azteca" />
        <img class="proof-logo" src="/images/logos/3_Audi.svg" alt="Audi" />
        <img class="proof-logo" src="/images/logos/2_logo-banorte.svg" alt="Banorte" />
        <img class="proof-logo" src="/images/logos/4_seat.svg" alt="SEAT" />
        <img class="proof-logo" src="/images/logos/5_vw_logo.svg" alt="Volkswagen" />
      </div>
    </div>
  </div>

  <!-- ================================================================
       BENTO — Capacidades
       ================================================================ -->
  <section class="section reveal" id="capacidades">
    <div class="container">
      <div class="section-eyebrow">capacidades</div>
      <h2 class="section-title">Tres capas. <span class="accent">Una integración.</span></h2>
      <p class="section-sub">
        No vendemos servicios sueltos. Pensamos marca, producto e inteligencia como
        un solo sistema desde el primer día. Por eso el resultado se siente coherente, no ensamblado.
      </p>

      <div class="bento reveal-stagger">
        <!-- AI — card destacada -->
        <div class="bento-card featured">
          <span class="bento-tag">ai/</span>
          <h3 class="bento-title">AI integrada al producto.<br>No al pitch.</h3>
          <p class="bento-desc">
            Copilots embebidos, automatización de procesos clave, integración con OpenAI y Anthropic.
            La diferencia no es la IA — es saber dónde sirve y dónde no.
          </p>
          <ul class="bento-bullets">
            <li>Copilots y agentes embebidos en producto</li>
            <li>Automatización de flujos operativos</li>
            <li>Integración OpenAI · Anthropic · APIs</li>
            <li>Evaluación honesta de cuándo IA aporta</li>
          </ul>
          <div class="bento-visual">
            <div class="bento-visual-orb"></div>
            <svg class="bento-visual-rings" viewBox="0 0 200 200" aria-hidden="true">
              <circle cx="100" cy="100" r="50"/>
              <circle cx="100" cy="100" r="50"/>
              <circle cx="100" cy="100" r="50"/>
            </svg>
          </div>
        </div>

        <!-- Brand -->
        <div class="bento-card">
          <span class="bento-tag">brand/</span>
          <h3 class="bento-title">Brand</h3>
          <p class="bento-desc">
            Estrategia, identidad y sistema de marca que aguantan crecimiento.
            Un sistema, no un PDF.
          </p>
          <ul class="bento-bullets">
            <li>Posicionamiento + propuesta de valor</li>
            <li>Identidad: logo, paleta, tipografía</li>
            <li>Sistema de diseño con tokens</li>
          </ul>
        </div>

        <!-- Product -->
        <div class="bento-card">
          <span class="bento-tag">product/</span>
          <h3 class="bento-title">Product</h3>
          <p class="bento-desc">
            Diseño UI/UX y desarrollo con stack moderno.
            Construimos productos digitales en ciclos cortos.
          </p>
          <ul class="bento-bullets">
            <li>UI/UX en alta fidelidad</li>
            <li>Desarrollo Astro · Next.js</li>
            <li>Apps móviles cuando aplica</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================
       CASO DESTACADO — Las Cholulas
       ================================================================ -->
  <section class="section reveal" id="proyectos">
    <div class="container">
      <div class="section-eyebrow">caso destacado</div>
      <h2 class="section-title">Un sistema de producto digital,<br>con IA <span class="accent">donde importa.</span></h2>
      <p class="section-sub">
        Cómo reposicionamos una marca con tradición y le construimos una operación
        digital que opera 24/7.
      </p>

      <article class="project-card">
        <!-- Info lado izquierdo -->
        <div>
          <div class="project-meta">
            <span class="tag">brand/</span>
            <span class="tag">product/</span>
            <span class="tag">ai/</span>
          </div>
          <h3 class="project-title">Las Cholulas — sistema de producto digital con IA</h3>
          <p class="project-desc">
            Reposicionamos la marca conservando su equity. Construimos un producto donde la IA procesa
            reservaciones por WhatsApp, genera contenido de redes y reporta métricas en lenguaje natural.
          </p>

          <div class="project-metrics">
            <div>
              <div class="metric-label">Conversión</div>
              <div class="metric-value accent" data-count="184" data-prefix="+" data-suffix="%">+184%</div>
            </div>
            <div>
              <div class="metric-label">Duración</div>
              <div class="metric-value">12 sem</div>
            </div>
            <div>
              <div class="metric-label">ROI 1er año</div>
              <div class="metric-value">8x</div>
            </div>
          </div>

          <a href="/casos/las-cholulas" class="case-link">Ver caso completo <span>→</span></a>
        </div>

        <!-- Device mockup lado derecho -->
        <div class="device-mockup" aria-hidden="true">
          <div class="laptop">
            <div class="laptop-screen">
              <div class="laptop-content">
                <div class="mock-nav">
                  <span class="mock-dot"></span>
                  <span class="mock-dot"></span>
                  <span class="mock-dot"></span>
                  <span class="mock-url">lascholulas.com/admin</span>
                </div>
                <div class="mock-content">
                  <div class="mock-eyebrow">PANEL · HOY</div>
                  <div class="mock-headline">Buenas tardes,<br>Carlos</div>
                  <div class="mock-grid">
                    <div class="mock-stat">
                      <div class="mock-stat-label">RESERVAS HOY</div>
                      <div class="mock-stat-value">47</div>
                      <div class="mock-stat-trend">↑ 12% vs ayer</div>
                    </div>
                    <div class="mock-stat">
                      <div class="mock-stat-label">AI ATENDIÓ</div>
                      <div class="mock-stat-value green">38</div>
                      <div class="mock-stat-trend">81% auto</div>
                    </div>
                  </div>
                  <div class="mock-chat">
                    <div class="mock-chat-label">CHAT IA · ÚLTIMO MENSAJE</div>
                    <div class="mock-chat-msg">"Reservé mesa de 4 para María González, viernes 8pm. Confirmado por WhatsApp."</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- Phone -->
          <div class="phone">
            <div class="phone-content">
              <div class="phone-notch"></div>
              <div class="phone-eyebrow">RESERVAS</div>
              <div class="phone-title">Hoy<br>Las Cholulas</div>
              <div class="phone-card">
                <div class="phone-card-label">CONFIRMADAS</div>
                <div class="phone-card-val">47</div>
              </div>
              <div class="phone-card">
                <div class="phone-card-label">EN COLA</div>
                <div class="phone-card-val" style="color: var(--text-primary);">8</div>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- ================================================================
       STATS — Números con counter animation
       ================================================================ -->
  <section class="stats reveal-stagger">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-block">
          <div class="stat-number" data-count="8" data-prefix="" data-suffix="">8</div>
          <div class="stat-label">años construyendo<br>productos digitales</div>
        </div>
        <div class="stat-block">
          <div class="stat-number" data-count="40" data-prefix="" data-suffix="+">40+</div>
          <div class="stat-label">proyectos<br>entregados</div>
        </div>
        <div class="stat-block">
          <div class="stat-number" data-count="100" data-prefix="" data-suffix="%">100%</div>
          <div class="stat-label">proyectos con<br>IA integrada en 2026</div>
        </div>
        <div class="stat-block">
          <div class="stat-number" data-count="24" data-prefix="" data-suffix="h">24h</div>
          <div class="stat-label">respuesta a leads<br>calificados</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================
       PROCESO
       ================================================================ -->
  <section class="section reveal" id="proceso">
    <div class="container">
      <div class="section-eyebrow">proceso</div>
      <h2 class="section-title">Cómo trabajamos.</h2>
      <p class="section-sub">Ciclos cortos, equipos pequeños, transparencia radical. Cuatro etapas, 8 a 16 semanas.</p>

      <div class="process-timeline">
        <div class="process-line" aria-hidden="true"></div>
        <div class="process-grid reveal-stagger">
          <div class="process-step">
            <div class="process-node"></div>
            <div class="process-num">01 / discovery</div>
            <h3 class="process-title">Entendemos</h3>
            <p class="process-desc">Negocio, audiencia, restricciones reales. Sin briefs genéricos. Una semana de inmersión real.</p>
          </div>
          <div class="process-step">
            <div class="process-node"></div>
            <div class="process-num">02 / design</div>
            <h3 class="process-title">Diseñamos</h3>
            <p class="process-desc">Marca y producto al mismo tiempo. Un equipo, una cadencia, sin entregas en cascada.</p>
          </div>
          <div class="process-step">
            <div class="process-node"></div>
            <div class="process-num">03 / build</div>
            <h3 class="process-title">Construimos</h3>
            <p class="process-desc">Stack moderno, deploys continuos, demos cada dos semanas. IA viva desde el día uno.</p>
          </div>
          <div class="process-step">
            <div class="process-node"></div>
            <div class="process-num">04 / ship</div>
            <h3 class="process-title">Lanzamos</h3>
            <p class="process-desc">Producción, iteración, monitoreo. Soporte hasta que el producto vuela solo.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================
       BENEFICIOS — Por qué 3dev
       ================================================================ -->
  <section class="section reveal" id="por-que">
    <div class="container">
      <div class="section-eyebrow">por qué 3dev</div>
      <h2 class="section-title">No somos una<br>agencia más.</h2>
      <p class="section-sub">
        Seis razones técnicas por las que founders, CTOs y directores de innovación
        nos contratan en lugar de la opción obvia.
      </p>

      <div class="benefits-grid">
        <div class="benefit">
          <div class="benefit-icon">01</div>
          <h3 class="benefit-title">Equipo dedicado</h3>
          <p class="benefit-desc">4 a 7 personas asignadas a tu proyecto. Nunca pool de freelancers con coordinador.</p>
        </div>
        <div class="benefit">
          <div class="benefit-icon">02</div>
          <h3 class="benefit-title">Stack del 2026</h3>
          <p class="benefit-desc">Astro, Next.js, Sanity, Anthropic API. No WordPress, no plantillas, no Webflow no-code.</p>
        </div>
        <div class="benefit">
          <div class="benefit-icon">03</div>
          <h3 class="benefit-title">IA-first, no IA-pegada</h3>
          <p class="benefit-desc">Integramos modelos al flujo del producto desde el discovery. No al final como decoración.</p>
        </div>
        <div class="benefit">
          <div class="benefit-icon">04</div>
          <h3 class="benefit-title">Demos cada 2 semanas</h3>
          <p class="benefit-desc">Verás progreso real cada quince días. Sin "estamos avanzando" sin entregable.</p>
        </div>
        <div class="benefit">
          <div class="benefit-icon">05</div>
          <h3 class="benefit-title">Honestidad radical</h3>
          <p class="benefit-desc">Si tu proyecto no encaja con nosotros, te lo decimos en 24 horas. No te perseguimos.</p>
        </div>
        <div class="benefit">
          <div class="benefit-icon">06</div>
          <h3 class="benefit-title">Mexicanos sin complejos</h3>
          <p class="benefit-desc">Cobramos precios premium porque entregamos calidad premium. Sin disculpa por geografía.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================
       TESTIMONIAL
       ================================================================ -->
  <section class="section testimonial-section reveal">
    <div class="container">
      <div class="testimonial-card">
        <div class="quote-mark" aria-hidden="true">"</div>
        <blockquote class="testimonial-quote">
          Pensábamos contratar una agencia para el sitio y otra para automatizar la operación.
          3dev nos resolvió ambas con un solo equipo, en menos tiempo y con resultados que no esperábamos.
          La diferencia se nota desde el primer entregable.
        </blockquote>
        <div class="testimonial-author">
          <div class="author-avatar">CR</div>
          <div class="author-info">
            <span class="author-name">Carlos Ramírez <span class="placeholder-tag">[CONFIRMAR]</span></span>
            <span class="author-role">Director · Las Cholulas Group</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================
       FINAL CTA
       ================================================================ -->
  <section class="final-cta" id="contacto-home">
    <div class="final-cta-bg" aria-hidden="true"></div>
    <div class="container">
      <div class="final-cta-content reveal">
        <h2 class="cta-title">¿Listo para construir<br>algo <span class="text-gradient">que importe?</span></h2>
        <p class="cta-sub">
          Cuéntanos qué quieres construir. Respondemos en menos de 24 horas hábiles.
          Si tu proyecto no encaja con lo que hacemos, te lo decimos honestamente.
        </p>
        <div class="cta-actions">
          <a href="/contacto" class="btn-primary">
            <span>Agendar conversación</span>
            <span>→</span>
          </a>
          <span class="cta-mail">o escríbenos a <a href="mailto:contacto@3dev.mx">contacto@3dev.mx</a></span>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<!-- ================================================================
     ESTILOS DE PÁGINA — home only
     ================================================================ -->
<style>
  /* ---- HERO ---- */
  .hero {
    min-height: 100vh;
    padding: 180px 0 120px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 920px;
  }

  /* Stagger de entrada en hero */
  .hero-content > * {
    opacity: 0;
    animation: heroFadeIn 1000ms cubic-bezier(.22,1,.36,1) forwards;
  }
  .hero-content > *:nth-child(1) { animation-delay: 200ms; }
  .hero-content > *:nth-child(2) { animation-delay: 320ms; }
  .hero-content > *:nth-child(3) { animation-delay: 460ms; }
  .hero-content > *:nth-child(4) { animation-delay: 600ms; }

  /* Badge */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px 7px 10px;
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border-accent);
    border-radius: var(--r-full);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.3px;
    color: var(--text-primary);
    margin-bottom: 36px;
  }
  .badge-dot {
    width: 6px;
    height: 6px;
    background: var(--accent-default);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--accent-default);
    animation: pulse 2s ease-in-out infinite;
    flex-shrink: 0;
  }
  .badge-divider { width: 1px; height: 12px; background: var(--border-default); }
  .badge-accent { color: var(--accent-default); }

  /* H1 */
  .hero h1 {
    font-size: clamp(46px, 7vw, 92px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -3.5px;
    margin-bottom: 28px;
    color: var(--text-primary);
  }
  .hero h1 .accent { color: var(--accent-default); }

  /* Cursor parpadeante */
  .cursor {
    display: inline-block;
    width: 0.45em;
    height: 0.85em;
    background: var(--accent-default);
    margin-left: 0.08em;
    vertical-align: -0.05em;
    animation: blink 1.2s step-end infinite;
    border-radius: 1px;
  }

  .hero-sub {
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.55;
    color: var(--text-secondary);
    max-width: 560px;
    margin-bottom: 44px;
  }

  .hero-cta { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }

  /* Botones hero — más grandes que los del componente Button */
  .btn-primary {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    background: var(--grad-accent);
    color: var(--text-on-accent);
    padding: 15px 26px;
    border-radius: 7px;
    position: relative;
    overflow: hidden;
    transition: transform var(--m-fast), box-shadow var(--m-base);
    box-shadow: 0 4px 20px rgba(93,196,164,0.25), inset 0 1px 0 rgba(255,255,255,0.15);
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .btn-primary::before {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.28), transparent);
    transition: left 700ms var(--ease-out);
  }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(93,196,164,0.45), inset 0 1px 0 rgba(255,255,255,0.2); }
  .btn-primary:hover::before { left: 100%; }
  .btn-primary:active { transform: translateY(0); }

  .btn-secondary {
    font-family: var(--font-mono);
    font-size: 13px;
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
    color: var(--text-primary);
    padding: 15px 22px;
    border-radius: 7px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: border-color var(--m-base), transform var(--m-fast), background var(--m-base);
  }
  .btn-secondary:hover {
    border-color: var(--glass-border-accent);
    background: var(--glass-bg-strong);
    transform: translateY(-2px);
  }

  /* Scroll hint */
  .scroll-hint {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-tertiary);
    letter-spacing: 1.5px;
    z-index: 3;
    animation: fadeIn 1s cubic-bezier(.22,1,.36,1) 1.8s both;
  }
  .scroll-hint-line {
    width: 1px;
    height: 32px;
    background: linear-gradient(180deg, transparent, var(--accent-default));
    animation: scrollLine 2s ease-in-out infinite;
  }
  @keyframes scrollLine {
    0%, 100% { transform: scaleY(1); transform-origin: top; opacity: 0.5; }
    50%       { transform: scaleY(0.5); transform-origin: top; opacity: 1; }
  }

  /* ---- SECTIONS GENERIC ---- */
  .section { padding: 140px 0; position: relative; }

  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.8px;
    color: var(--accent-default);
    text-transform: lowercase;
    margin-bottom: 20px;
    padding: 5px 12px;
    background: rgba(93,196,164,0.08);
    border: 1px solid var(--glass-border-accent);
    border-radius: var(--r-full);
  }

  .section-title {
    font-size: clamp(32px, 4.5vw, 52px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -1.8px;
    margin-bottom: 22px;
    max-width: 720px;
    color: var(--text-primary);
  }
  .section-title .accent { color: var(--accent-default); }

  .section-sub {
    font-size: 17px;
    line-height: 1.55;
    color: var(--text-secondary);
    max-width: 560px;
    margin-bottom: 64px;
  }

  /* ---- MARQUEE ---- */
  .proof {
    padding: 60px 0;
    border-top: 1px solid var(--border-sub);
    border-bottom: 1px solid var(--border-sub);
    position: relative;
    overflow: hidden;
    background: var(--surface-bg);
  }
  .proof-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.8px;
    color: var(--text-tertiary);
    text-transform: lowercase;
    margin-bottom: 24px;
    text-align: center;
  }
  .marquee {
    display: flex;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, black 10%, black 90%, transparent);
  }
  .marquee-track {
    display: flex;
    gap: 80px;
