---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import { Image } from 'astro:assets';
import projectScreen from '../assets/las-cholulas-negocios.png';
const capabilities = [
  { number:'01', name:'Brand', line:'La identidad que sostiene todo.', text:'Estrategia, identidad y sistema de marca que aguantan crecimiento. Pensamos cómo se ve, cómo habla y cómo se comporta tu producto.', outputs:['Posicionamiento','Identidad visual','Sistema de diseño'] },
  { number:'02', name:'Product', line:'De una buena idea a algo que se usa.', text:'Diseño UX/UI y desarrollo en la misma conversación. Convertimos necesidades reales en experiencias claras, funcionales y listas para evolucionar.', outputs:['Experiencia de usuario','Diseño de interfaces','Desarrollo web'] },
  { number:'03', name:'AI', line:'Inteligencia donde cambia las cosas.', text:'Asistentes, automatizaciones e integración de modelos en el flujo del producto. Primero entendemos el problema. Después decidimos si necesita IA.', outputs:['Asistentes integrados','Automatización','Evaluación de modelos'] },
];
const steps = [
  { number:'01', name:'Entendemos.', label:'discovery', text:'Negocio, audiencia y restricciones reales. Acordamos qué vale la pena construir y cómo sabremos si funciona.' },
  { number:'02', name:'Diseñamos.', label:'design', text:'Marca y producto al mismo tiempo. Hacemos tangible la idea, probamos el recorrido y resolvemos los detalles.' },
  { number:'03', name:'Construimos.', label:'build', text:'Diseño y desarrollo trabajan juntos. Entregas visibles, conversaciones directas y decisiones compartidas.' },
  { number:'04', name:'Lanzamos.', label:'ship', text:'Ponemos el producto en manos de las personas. Observamos, medimos e iteramos con lo que aprendemos.' },
];
---
<BaseLayout title="3dev — Brand · Product · AI" description="Estudio mexicano de diseño y tecnología. Integramos marca, producto e inteligencia para construir productos digitales con criterio.">
  <Hero />
  <section class="clients container" aria-label="Empresas con las que hemos trabajado">
    <p>hemos construido<br />con equipos de</p>
    <div class="client-logos">
      <img src="/images/logos/1_tv-azteca-04.svg" alt="TV Azteca" width="120" height="36" />
      <img src="/images/logos/3_Audi.svg" alt="Audi" width="100" height="36" />
      <img src="/images/logos/2_logo-banorte.svg" alt="Banorte" width="120" height="36" />
      <img src="/images/logos/4_seat.svg" alt="SEAT" width="100" height="36" />
      <img src="/images/logos/5_vw_logo.svg" alt="Volkswagen" width="44" height="44" />
    </div>
  </section>

  <section class="work" id="proyectos" data-surface="paper" aria-labelledby="work-title">
    <div class="container">
      <div class="section-meta"><span>01 / trabajo seleccionado</span><a href="/casos">todos los proyectos <span aria-hidden="true">↗</span></a></div>
      <div class="work-heading"><h2 id="work-title">Lo que hacemos.<br /><span>En el mundo real.</span></h2><p>El diseño se demuestra en el producto.<br />Y el producto, en cómo se usa.</p></div>
      <article class="project">
        <div class="project-title"><h3>Las Cholulas<span aria-hidden="true">↗</span></h3><div><span>ecosistema digital</span><span>producto / web</span></div></div>
        <a class="work-screen" href="/casos/las-cholulas" aria-label="Ver el caso de Las Cholulas">
          <div class="screen-caption"><span>lascholulas.com / para negocios</span><span>sitio web <span aria-hidden="true">↗</span></span></div>
          <div class="screen-crop"><Image src={projectScreen} alt="Página de Las Cholulas para negocios, con su propuesta de directorio, menú digital y lealtad." widths={[640,960,1280,1600]} sizes="(max-width: 767px) 90vw, 85vw" width={1600} format="webp" quality={85} loading="lazy" /></div>
        </a>
        <div class="project-description"><p>Un punto de encuentro entre los negocios de Cholula y las personas que quieren descubrirlos.</p><div><p>Directorio, menú digital y herramientas para conectar la presencia online con la experiencia local.</p><a href="/casos/las-cholulas" class="plain-link">Explorar el caso <span aria-hidden="true">↗</span></a></div></div>
      </article>
    </div>
  </section>

  <section class="capabilities container" id="capacidades" aria-labelledby="capabilities-title">
    <div class="section-meta"><span>02 / capacidades</span><span>partes de un mismo sistema</span></div>
    <div class="cap-intro"><h2 id="capabilities-title">Pensamos en tres capas.<br /><span>Construimos como uno.</span></h2><p>La marca define. El producto conecta.<br />La inteligencia amplifica.</p></div>
    <div class="cap-list">
      {capabilities.map((cap,i) => <details name="capabilities" open={i===0}>
        <summary><span class="cap-number">{cap.number}</span><h3>{cap.name}<span>/</span></h3><span class="cap-line">{cap.line}</span><span class="cap-toggle" aria-hidden="true">+</span></summary>
        <div class="cap-detail"><p>{cap.text}</p><ul>{cap.outputs.map(output => <li>{output}</li>)}</ul></div>
      </details>)}
    </div>
    <a class="plain-link capabilities-link" href="/capacidades">Conoce nuestro enfoque <span aria-hidden="true">↗</span></a>
  </section>

  <section class="process" id="proceso" data-surface="paper" aria-labelledby="process-title">
    <div class="container process-grid">
      <div class="process-intro"><span class="label">03 / el proceso</span><h2 id="process-title">Del problema<br />al producto.</h2><p>Sin cajas negras.<br />Sabes qué estamos haciendo,<br />por qué y qué sigue.</p><div class="process-sign" aria-hidden="true">↘</div></div>
      <ol class="process-steps">{steps.map(step => <li><div class="step-meta"><span>{step.number}</span><span>{step.label}</span></div><h3>{step.name}</h3><p>{step.text}</p></li>)}</ol>
    </div>
  </section>

  <section class="manifesto container" id="por-que" aria-labelledby="manifesto-title">
    <div class="section-meta"><span>04 / el estudio</span><span>Puebla, México · trabajando sin fronteras</span></div>
    <h2 id="manifesto-title">No somos una<br />agencia <span>más.</span></h2>
    <div class="manifesto-bottom"><p class="manifesto-lead">Nos importa tanto<br />cómo se siente,<br />como <em>cómo funciona.</em></p><div class="principles"><p><span>01</span> Un equipo. Una conversación.</p><p><span>02</span> IA con criterio, no por moda.</p><p><span>03</span> Progreso que puedes ver.</p><p><span>04</span> Honestidad desde el primer día.</p><p><span>05</span> Diseño que llega a producción.</p><p><span>06</span> Talento mexicano. Estándar global.</p></div></div>
  </section>

  <section class="closing" id="contacto-home" aria-labelledby="closing-title">
    <div class="container"><div class="closing-top"><span>el siguiente proyecto puede ser el tuyo</span><span>brand · product · ai</span></div><a href="/contacto" class="closing-link"><h2 id="closing-title">¿Algo que valga<br />la pena construir?</h2><span aria-hidden="true">↗</span></a><div class="closing-bottom"><span>Hagámoslo realidad.</span><a href="/contacto">Cuéntanos tu proyecto <span aria-hidden="true">↗</span></a></div></div>
  </section>
</BaseLayout>
<style>
  h2 { font-size: clamp(32px,4.1vw,60px); font-weight: 500; line-height: 1.07; letter-spacing: -0.055em; }
  .section-meta { display: flex; justify-content: space-between; align-items: center; gap: var(--s-5); font: 11px/1.5 var(--font-mono); color: var(--text-secondary); margin-bottom: var(--s-12); }
  .section-meta a { display: inline-flex; gap: var(--s-6); align-items: center; min-height: 44px; color: var(--text-primary); transition: color var(--m-fast) var(--ease-out); }
  .section-meta a:hover { color: var(--accent-default); }
  .clients { display: flex; align-items: center; gap: var(--s-12); padding-block: var(--s-10) var(--s-16); }
  .clients p { flex-shrink: 0; font: 11px/1.6 var(--font-mono); color: var(--text-secondary); }
  .client-logos { flex: 1; display: flex; justify-content: space-between; align-items: center; gap: var(--s-8); }
  .client-logos img { object-fit: contain; max-width: 120px; filter: brightness(0) invert(1); opacity: 0.7; }
  .work { padding-block: var(--section-space); background: var(--surface-bg); color: var(--text-primary); }
  .work-heading { display: flex; justify-content: space-between; align-items: end; gap: var(--s-8); margin-bottom: var(--s-16); }
  .work-heading h2 span { color: var(--text-secondary); }
  .work-heading p { font-size: 15px; line-height: 1.6; color: var(--text-secondary); }
  .project-title { display: flex; align-items: end; justify-content: space-between; gap: var(--s-8); padding-top: var(--s-8); border-top: 1px solid var(--border-default); margin-bottom: var(--s-8); }
  .project-title h3 { display: flex; align-items: baseline; gap: var(--s-6); font-size: clamp(40px,6.7vw,96px); font-weight: 500; line-height: 1; letter-spacing: -0.065em; }
  .project-title h3 span { font-size: 0.5em; font-weight: 400; }
  .project-title div { display: grid; gap: var(--s-1); font: 11px/1.5 var(--font-mono); }
  .work-screen { display: block; border: 1px solid var(--border-default); background: var(--surface-elev); border-radius: var(--r-sm); overflow: hidden; transition: border-color var(--m-fast) var(--ease-out); }
  .work-screen:hover { border-color: var(--accent-default); }
  .screen-caption { display: flex; justify-content: space-between; gap: var(--s-4); padding: var(--s-3) var(--s-5); font: 10px/1.5 var(--font-mono); background: var(--surface-elev); }
  .screen-crop { aspect-ratio: 1.9; overflow: hidden; }
  .screen-crop img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform var(--m-slow) var(--ease-out); }
  .work-screen:hover img { transform: scale(1.015); }
  .project-description { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-16); margin-top: var(--s-8); }
  .project-description > p { font-size: clamp(20px,2.4vw,30px); line-height: 1.35; letter-spacing: -0.035em; max-width: 30ch; }
  .project-description > div { max-width: 45ch; font-size: 15px; line-height: 1.65; color: var(--text-secondary); }
  .plain-link { display: inline-flex; align-items: center; justify-content: space-between; gap: var(--s-10); min-height: 48px; border-bottom: 1px solid currentColor; font: 12px/1.5 var(--font-mono); color: var(--text-primary); transition: color var(--m-fast) var(--ease-out); }
  .plain-link span { transition: transform var(--m-fast) var(--ease-out); }
  .plain-link:hover { color: var(--accent-default); }
  .plain-link:hover span { transform: translate(3px,-3px); }
  .project-description .plain-link { margin-top: var(--s-5); }
  .capabilities { padding-block: var(--section-space); }
  .cap-intro { display: flex; justify-content: space-between; align-items: end; gap: var(--s-8); margin-bottom: var(--s-16); }
  .cap-intro h2 span { color: var(--accent-default); }
  .cap-intro p { font-size: 14px; color: var(--text-secondary); line-height: 1.6; }
  .cap-list details { border-top: 1px solid var(--border-default); }
  .cap-list details:last-child { border-bottom: 1px solid var(--border-default); }
  summary { list-style: none; display: grid; grid-template-columns: 52px 1fr 1fr 32px; align-items: center; gap: var(--s-6); cursor: pointer; padding-block: var(--s-8); }
  summary::-webkit-details-marker { display: none; }
  summary:hover h3 { color: var(--accent-default); }
  .cap-number { font: 11px var(--font-mono); color: var(--text-secondary); }
  summary h3 { font-size: clamp(42px,6.1vw,80px); line-height: 1; font-weight: 400; letter-spacing: -0.06em; }
  summary h3 span { color: var(--accent-default); }
  .cap-line { font-size: 15px; color: var(--text-secondary); }
  .cap-toggle { font: 300 30px var(--font-sans); color: var(--accent-default); transition: transform var(--m-fast); }
  details[open] .cap-toggle { transform: rotate(45deg); }
  details[open] h3 { color: var(--accent-default); }
  .cap-detail { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-12); padding: 0 var(--s-16) var(--s-10) 76px; }
  .cap-detail p { max-width: 48ch; color: var(--text-secondary); font-size: 15px; line-height: 1.7; }
  .cap-detail ul { list-style: none; display: grid; gap: var(--s-2); font: 11px/1.6 var(--font-mono); }
  .cap-detail li::before { content: '↳ '; color: var(--accent-default); margin-right: var(--s-2); }
  .capabilities-link { margin-top: var(--s-8); }
  .process { padding-block: var(--section-space); background: var(--surface-bg); color: var(--text-primary); }
  .process-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-16); }
  .process-intro { position: sticky; top: 128px; align-self: start; }
  .label { font: 11px/1.5 var(--font-mono); color: var(--text-secondary); }
  .process-intro h2 { margin-top: var(--s-10); }
  .process-intro p { margin-top: var(--s-6); font-size: 16px; line-height: 1.7; color: var(--text-secondary); }
  .process-sign { font: 300 120px/1 var(--font-sans); color: var(--accent-default); margin-top: var(--s-10); }
  .process-steps { list-style: none; }
  .process-steps li { padding-block: var(--s-10); border-top: 1px solid var(--border-default); }
  .process-steps li:first-child { padding-top: 0; border-top: 0; }
  .step-meta { display: flex; justify-content: space-between; align-items: center; font: 11px/1.5 var(--font-mono); color: var(--text-secondary); }
  .step-meta span:first-child { font-size: 28px; color: var(--accent-default); }
  .process-steps h3 { font-size: clamp(28px,3vw,40px); font-weight: 500; letter-spacing: -0.04em; margin-block: var(--s-5) var(--s-3); }
  .process-steps p { font-size: 16px; line-height: 1.7; color: var(--text-secondary); max-width: 45ch; }
  .manifesto { padding-block: var(--section-space); }
  .manifesto h2 { font-size: clamp(52px,9.3vw,128px); line-height: 1; }
  .manifesto h2 span { color: var(--accent-default); }
  .manifesto-bottom { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-16); margin-top: var(--s-16); }
  .manifesto-lead { font-size: clamp(24px,3vw,38px); line-height: 1.35; letter-spacing: -0.035em; }
  .manifesto-lead em { font-style: normal; color: var(--text-secondary); }
  .principles p { padding-block: var(--s-4); border-top: 1px solid var(--border-default); display: flex; align-items: baseline; gap: var(--s-6); font-size: 15px; }
  .principles span { color: var(--accent-default); font: 10px var(--font-mono); }
  .closing { background: var(--surface-brand); color: var(--text-on-brand); padding-block: var(--s-10) var(--s-12); }
  .closing-top, .closing-bottom { display: flex; justify-content: space-between; gap: var(--s-8); font: 11px/1.5 var(--font-mono); }
  .closing-link { display: flex; justify-content: space-between; align-items: center; gap: var(--s-10); padding-block: var(--s-16); }
  .closing-link h2 { font-size: clamp(38px,6.8vw,96px); }
  .closing-link > span { font: 300 clamp(60px,10vw,150px)/1 var(--font-sans); transition: transform var(--m-base) var(--ease-out); }
  .closing-link:hover > span { transform: translate(6px,-6px); }
  .closing-bottom { border-top: 1px solid currentColor; padding-top: var(--s-5); align-items: center; }
  .closing-bottom > span { font-size: 18px; font-family: var(--font-sans); }
  .closing-bottom a { display: flex; align-items: center; gap: var(--s-8); min-height: 44px; }
  @media (max-width: 63.99rem) { .clients { gap: var(--s-8); } .client-logos { gap: var(--s-6); } .client-logos img { max-width: 90px; } .work-heading,.cap-intro { align-items: start; flex-direction: column; } .project-title { align-items: start; } .project-description,.manifesto-bottom,.process-grid { gap: var(--s-8); } summary { grid-template-columns: 32px 1fr 1fr 24px; gap: var(--s-4); } .cap-detail { padding-left: 48px; padding-right: 0; } }
  @media (max-width: 47.99rem) { .section-meta { margin-bottom: var(--s-8); font-size: 10px; } .section-meta > span:last-child:not(:first-child) { display: none; } .clients { display: block; padding-block: var(--s-6) var(--s-12); } .clients p br { display: none; } .client-logos { display: grid; grid-template-columns: repeat(3,1fr); gap: var(--s-6); margin-top: var(--s-6); align-items: center; } .client-logos img { max-width: 85px; max-height: 28px; } .client-logos img:last-child { max-width: 32px; max-height: 32px; } .work-heading,.cap-intro { margin-bottom: var(--s-10); gap: var(--s-5); } .project-title { flex-direction: column; gap: var(--s-4); margin-bottom: var(--s-5); } .project-title div { display: flex; gap: var(--s-5); font-size: 10px; } .screen-caption { font-size: 8px; padding: var(--s-3); } .screen-caption > span:last-child { display: none; } .screen-crop { aspect-ratio: 1.1; } .project-description,.manifesto-bottom,.process-grid { grid-template-columns: 1fr; gap: var(--s-6); } .project-description > p { max-width: 28ch; } .cap-line { display: none; } summary { grid-template-columns: 24px 1fr 24px; padding-block: var(--s-6); } .cap-detail { grid-template-columns: 1fr; gap: var(--s-5); padding: 0 0 var(--s-6) 40px; } .cap-detail p { font-size: 14px; } .process-intro { position: static; } .process-intro h2 { margin-top: var(--s-6); } .process-sign { display: none; } .process-steps { margin-top: var(--s-6); } .process-steps li:first-child { padding-top: var(--s-6); border-top: 1px solid var(--border-default); } .manifesto-bottom { margin-top: var(--s-10); gap: var(--s-10); } .principles p { font-size: 14px; gap: var(--s-4); } .closing-top span:last-child { display: none; } .closing-link { align-items: end; gap: var(--s-3); padding-block: var(--s-12); } .closing-link h2 { font-size: clamp(32px,8.5vw,48px); } .closing-link > span { font-size: 48px; } .closing-bottom { align-items: start; flex-direction: column; gap: var(--s-3); } }
</style>
